    def prop_field_value(field):
        """取当前路径某个可编辑字段的显示值（真读磁盘，失败给空）"""
        try:
            st = os.lstat(prop_path)
        except OSError:
            return ""
        if field == "name":
            return os.path.basename(prop_path.rstrip("/"))
        if field == "perm":
            return oct(st.st_mode & 0o777)[2:]
        if field == "mtime":
            return fmt_time(st.st_mtime)
        return ""

