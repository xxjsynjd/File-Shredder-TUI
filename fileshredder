                                    else "输入关键词开始搜索")
                    dirty = True
                    continue
                if key == "ENTER":
                    if cmd_search_matches:
                        cmd_search_pos = cmd_search_matches[cmd_search_sel]
                        cmd_buffer = hist_list[cmd_search_pos]
                        cmd_cur = len(cmd_buffer)
                        cmd_hist_idx = cmd_search_pos
                    cmd_search_mode = False
                    cmd_note = "已选历史命令，可编辑后再 ENTER 执行"
