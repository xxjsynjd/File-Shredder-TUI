        except ValueError:
            raise ValueError("结束位置写数字（单位 MB）")
        path, _sz = dk_cur_dev()
        if not shutil.which("parted"):
            raise ValueError("没装 parted：pkg install parted")
        return (f"设置分区 #{p0['num']} 大小 → 结束于 {e:g} MB",
                [["parted", "-s", path, "unit", "MB", "resizepart",
                  str(p0["num"]), f"{e:g}"]],
                "只改分区表边界，文件系统之后还要 resize2fs / resize.f2fs 才能用满",
                "")

    def _mbr_cb(f):
        src = f["src"].strip().lower() or "auto"
        path, _sz = dk_cur_dev()
        if src == "auto":
            for c in ("/usr/share/syslinux/mbr.bin",
                      os.path.join(os.environ.get("PREFIX", "/usr"), "share",
                                   "syslinux", "mbr.bin")):
                if os.path.exists(c):
                    src = c
                    break
        if src == "auto":
            raise ValueError("没找到 mbr.bin；可以把来源填 zero（清空前 440 字节），"
                             "或给一个 mbr.bin 的路径")
        if src == "zero":
            cmds = [["dd", "if=/dev/zero", f"of={path}", "bs=440", "count=1",
                     "conv=notrunc"]]
            return ("清零主引导记录（前 440 字节）", cmds,
                    "清掉 MBR 引导码后这张盘不能直接启动，但分区表（446 起）保留", "")
        if not os.path.exists(src):
            raise ValueError(f"找不到 {src}")
        return ("写入主引导记录", [["dd", f"if={src}", f"of={path}", "bs=440",
                                    "count=1", "conv=notrunc"]],
                "只覆盖前 440 字节引导码，分区表在 446 之后不受影响", "")

    def _label_cb(f):
