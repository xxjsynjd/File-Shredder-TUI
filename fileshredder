    TERMUX_LOGIN = "/data/data/com.termux/files/usr/bin/login"
    TERM_ARGS = {
        "xfce4-terminal": [("working-directory",
                            lambda d: ["--working-directory", d])],
        "qterminal": [("workdir", lambda d: ["--workdir", d]),
                      ("--dir", lambda d: ["--dir=" + d])],
        "konsole": [("workdir", lambda d: ["--workdir", d])],
        "gnome-terminal": [("working-directory",
                            lambda d: ["--working-directory", d])],
        "mate-terminal": [("working-directory",
                           lambda d: ["--working-directory", d])],
        "terminator": [("working-directory",
                        lambda d: ["--working-directory", d])],
        "tilix": [("working-directory",
                   lambda d: ["--working-directory", d])],
        "lxterminal": [("working-directory",
                        lambda d: ["--working-directory=" + d])],
        "kitty": [("directory", lambda d: ["--directory", d])],
        "alacritty": [("working-directory",
                       lambda d: ["--working-directory", d])],
        "xterm": [(None, lambda d: [])],
    }
    TERM_PROBE = {}

    TERM_NAMES = ("qterminal", "xfce4-terminal", "xfce4-terminal-",
                  "konsole", "gnome-terminal", "mate-terminal", "tilix",
                  "terminator", "lxterminal", "kitty", "alacritty", "urxvt",
                  "wezterm", "st-", "xterm")

    def detect_terminal_env():
        """沿 /proc 父进程链往上爬，看这个程序到底是被谁拉起来的"""
        chain = []
        pid = os.getpid()
        for _ in range(16):
            try:
                with open(f"/proc/{pid}/stat", "r", errors="replace") as f0:
                    fields = f0.read().rsplit(")", 1)[-1].split()
                ppid = int(fields[1])
            except (OSError, ValueError, IndexError):
                break
            if ppid <= 1:
                break
            try:
                with open(f"/proc/{ppid}/comm", "r", errors="replace") as f1:
                    comm = f1.read().strip()
            except OSError:
                break
            chain.append(comm)
            low = comm.lower()
            for n in TERM_NAMES:
                if low.startswith(n):
                    return {"kind": "desktop", "name": n.rstrip("-"),
                            "comm": comm, "chain": chain}
            if "termux" in low:
                return {"kind": "termux", "name": comm, "comm": comm,
                        "chain": chain}
            pid = ppid
        return {"kind": "", "name": "", "comm": "", "chain": chain}

    def _in_termux():
        if os.environ.get("TERMUX_VERSION"):
            return True
        prefix = os.environ.get("PREFIX", "")
        return prefix.startswith("/data/data/com.termux")

    def _term_supports(bin, token):
        """跑一次 --help 看这个终端认不认某个开关（按 bin+token 缓存）"""
        ck = (bin, token)
        if ck in TERM_PROBE:
            return TERM_PROBE[ck]
        ok = False
        if token:
            try:
                r0 = subprocess.run([bin, "--help"], stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, timeout=3,
                                    text=True, errors="replace")
                ok = token in (r0.stdout or "")
            except (OSError, subprocess.SubprocessError):
                ok = False
        TERM_PROBE[ck] = ok
        return ok

    def term_extra(bin_name, d):
        """按这个终端的 --help 挑一种它认的「带目录」写法，认不出就给空参数"""
        for token, argf in TERM_ARGS.get(bin_name, []):
            if token is None:
                return argf(d)
            if _term_supports(bin_name, token):
                return argf(d)
        return []

    def _pick_terminal():
        env_term = os.environ.get("TERMINAL", "").strip()
        cands = []
        if env_term:
            cands.append(os.path.basename(env_term))
        cands += ["qterminal", "xfce4-terminal", "konsole", "gnome-terminal",
                  "mate-terminal", "terminator", "tilix", "lxterminal",
                  "kitty", "alacritty", "xterm"]
        for n in cands:
            if n in TERM_ARGS and shutil.which(n):
                return n
        return ""

    def open_terminal_here():
        """当前目录丢进新终端：Termux 走 RunCommandService，桌面走各终端的 --workdir"""
        nonlocal dirty
        d = current_pwd
        # 先看有没有图形桌面：Termux + Termux:X11（XFCE）里跑，也走 qterminal 那条
        det = detect_terminal_env()
        has_display = bool(os.environ.get("DISPLAY")
                           or os.environ.get("WAYLAND_DISPLAY"))
        if det["kind"] == "termux":
            has_display = False          # 被 Termux 本体拉起 → 一定走 am
        desk_bin = ""
        if det["kind"] == "desktop" and shutil.which(det["name"]):
            desk_bin = det["name"]       # 用发起它的同一个终端
        elif has_display:
            desk_bin = _pick_terminal()
        if desk_bin:
            extra = term_extra(desk_bin, d)
            argv = [shutil.which(desk_bin)] + extra
            try:
                p0 = subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                                      stdout=subprocess.DEVNULL,
                                      stderr=subprocess.DEVNULL,
                                      start_new_session=True, cwd=d)
            except OSError as e:
                set_status(f"启动 {desk_bin} 失败: {e}")
                return
            time.sleep(0.4)
            if p0.poll() not in (None, 0):
                set_status(f"{desk_bin} 退出了（rc={p0.returncode}），"
                           f"可能不认这个参数: {' '.join(extra) or '(无参数)'}")
                return
            where = f"（检测到发起终端：{det['comm']}）" if det["comm"] else ""
            if extra:
                set_status(f"已在 {desk_bin}{where} 新窗口打开: {d}")
            else:
                set_status(f"已在 {desk_bin}{where} 新窗口打开"
                           f"（它没有 --workdir 类参数，cwd 已继承 {d}）")
            dirty = True
            return

        if _in_termux():
            am = shutil.which("am") or "/system/bin/am"
            login = TERMUX_LOGIN
            prefix = os.environ.get("PREFIX", "")
            if prefix and os.path.exists(os.path.join(prefix, "bin", "login")):
                login = os.path.join(prefix, "bin", "login")
            argv = [am, "startservice", "--user", "0", "-n",
                    "com.termux/com.termux.app.RunCommandService",
                    "-a", "com.termux.RUN_COMMAND",
                    "--es", "com.termux.RUN_COMMAND_PATH", login,
                    "--es", "com.termux.RUN_COMMAND_WORKDIR", d,
                    "--ez", "com.termux.RUN_COMMAND_BACKGROUND", "false"]
            try:
                r0 = subprocess.run(argv, stdout=subprocess.PIPE,
                                    stderr=subprocess.STDOUT, timeout=8,
                                    text=True, errors="replace")
            except (OSError, subprocess.SubprocessError) as e:
                set_status(f"调 am 失败: {e}")
                return
            out = (r0.stdout or "").strip().replace("\n", " ")
            if r0.returncode != 0 or "Error" in out or "Exception" in out:
                hint = ""
                if "permission" in out.lower():
                    hint = ("；要给 Termux 开 RUN_COMMAND 权限，"
                            "并在 ~/.termux/termux.properties 里设 allow-external-apps=true")
                set_status(f"打开失败: {out[:120] or 'am 返回 ' + str(r0.returncode)}"
                           + hint)
            else:
                who = (f"（检测到发起终端：{det['comm']}）" if det["comm"] else "")
                set_status(f"已在新 Termux 会话打开{who}: {d}")
            dirty = True
            return

        if not has_display:
            set_status("既没有图形会话（DISPLAY/WAYLAND_DISPLAY 都没设），"
                       "也没在 Termux 里，没法开新终端")
            dirty = True
            return

        bin_name = _pick_terminal()
        if not bin_name:
            set_status("没找到可用终端（qterminal / xfce4-terminal / konsole / xterm 都不在 PATH）")
            dirty = True
            return
        extra = term_extra(bin_name, d)
        argv = [shutil.which(bin_name)] + extra
        try:
            p0 = subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                                  stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL,
                                  start_new_session=True, cwd=d)
        except OSError as e:
            set_status(f"启动 {bin_name} 失败: {e}")
            return
        time.sleep(0.4)
        if p0.poll() not in (None, 0):
            set_status(f"{bin_name} 退出了（rc={p0.returncode}），"
                       f"可能不认这个参数: {' '.join(extra) or '(无参数)'}")
            return
        if extra:
            set_status(f"已在 {bin_name} 新窗口打开: {d}")
        else:
            set_status(f"已在 {bin_name} 新窗口打开（它没有 --workdir 类参数，"
                       f"cwd 已继承 {d}）")
        dirty = True

    def _port_of(v):
        try:
            p0 = int(str(v).strip())
        except ValueError:
            raise ValueError("端口要写数字，比如 8080")
        if not (1 <= p0 <= 65535):
            raise ValueError("端口范围 1-65535")
        return p0

    def _gotty_cb(f):
        b = shutil.which("gotty") or ""
        if not b:
            raise ValueError("没装 gotty：从 github.com/yudai/gotty/releases 拿 arm64 静态包，"
                             "或 go install github.com/yudai/gotty@latest")
        port = _port_of(f["port"])
        addr = f["addr"].strip() or "0.0.0.0"
        prog = shlex.split(f["prog"].strip() or "sh")
        args = shlex.split(f["argstr"].strip())
        extra = shlex.split(f["extra"].strip())
        argv = [b] + extra + ["-p", str(port), "-a", addr] + prog + args
        host = "<本机IP>" if addr in ("0.0.0.0", "") else addr
        return (f"GoTTY（{os.path.basename(prog[0])}）", argv,
                f"http://{host}:{port}")

    def _fb_cb(f):
        b = shutil.which("filebrowser") or ""
        if not b:
            raise ValueError("没装 filebrowser：github.com/filebrowser/filebrowser "
                             "的 releases 下 linux-arm64，或 go install "
                             "github.com/filebrowser/filebrowser@latest")
        root = f["root"].strip() or current_pwd
        if not os.path.isdir(root):
            raise ValueError(f"根目录不存在: {root}")
        port = _port_of(f["port"])
        addr = f["addr"].strip() or "0.0.0.0"
        extra = shlex.split(f["extra"].strip())
        argv = [b, "-r", root, "-p", str(port), "-a", addr] + extra
        host = "<本机IP>" if addr in ("0.0.0.0", "") else addr
        return (f"File Browser（{os.path.basename(root) or '/'}）", argv,
                f"http://{host}:{port}")

    # ---------------- 标签页 ----------------
    def tab_title(i):
        d = tabs[i] if i < len(tabs) and tabs[i] else None
        if d and (d.get("name") or "").strip():
            return d["name"]
        path = (d["cwd"] if d else (current_pwd if i == tab_idx else "/"))
        return os.path.basename(path.rstrip("/")) or path

    def tab_color(i):
        d = tabs[i] if i < len(tabs) and tabs[i] else None
        try:
            c = int(d.get("color", 0)) if d else 0
        except (TypeError, ValueError):
            c = 0
        return c if 0 <= c < len(TAB_COLOR_NAMES) else 0

    def tab_attr(i, active):
        attr = curses.A_NORMAL
        c = tab_color(i)
        if c and curses.has_colors():
            try:
                attr |= curses.color_pair(TAB_COLOR_PAIRS[c])
            except curses.error:
                pass
        return attr | (curses.A_REVERSE | curses.A_BOLD if active else 0)

    def tab_snapshot():
        nonlocal tabs
        prev = tabs[tab_idx] if tab_idx < len(tabs) and tabs[tab_idx] else {}
        tabs[tab_idx] = {
            "name": prev.get("name", ""),
            "color": prev.get("color", 0),
            "cwd": current_pwd,
            "orig": list(original_scan_entries),
            "entries": list(scan_entries),
            "cursor": cursor_idx,
            "sel": set(selected_set),
            "view": view_offset,
            "search_mode": search_mode,
            "search_kw": search_keyword,
            "matches": list(search_matches),
            "match_idx": current_match_idx,
            "nav_hist": list(nav_hist),
            "nav_idx": nav_idx,
            "nav_seen": nav_seen,
        }

    def tab_load(d):
        nonlocal current_pwd, original_scan_entries, scan_entries, cursor_idx, selected_set
        nonlocal view_offset, search_mode, search_keyword, search_matches, current_match_idx
        nonlocal nav_hist, nav_idx, nav_seen, status_msg, dirty
        current_pwd = d["cwd"]
        original_scan_entries = list(d["orig"])
        scan_entries = list(d["entries"])
        cursor_idx = d["cursor"] if d["entries"] else 0
        selected_set = set(d["sel"])
        view_offset = d["view"]
        search_mode = d["search_mode"]
        search_keyword = d["search_kw"]
        search_matches = list(d["matches"])
        current_match_idx = d["match_idx"]
        nav_hist = list(d["nav_hist"])
        nav_idx = d["nav_idx"]
        nav_seen = d["nav_seen"]
        status_msg = ""
        dirty = True
        if not scan_entries:
            rescan_directory()

    def switch_tab(i):
        nonlocal tab_idx
        if not tabs or i < 0 or i >= len(tabs) or i == tab_idx:
            return
        tab_snapshot()
        tab_idx = i
        tab_load(tabs[i])

    def new_tab(path=None):
        nonlocal tabs, tab_idx, dirty
        if len(tabs) >= 9:
            set_status("最多 9 个标签页")
            return
        tab_snapshot()
        target = os.path.abspath(os.path.expanduser(path)) if path else current_pwd
        if not os.path.isdir(target):
            target = current_pwd
        tabs.append({
            "name": "", "color": 0,
            "cwd": target, "orig": [], "entries": [], "cursor": 0, "sel": set(),
            "view": 0, "search_mode": False, "search_kw": "", "matches": [],
            "match_idx": 0, "nav_hist": [target], "nav_idx": 0, "nav_seen": target,
        })
        tab_idx = len(tabs) - 1
        tab_load(tabs[tab_idx])
        rescan_directory()
        set_status(f"新建标签页 {tab_idx + 1}/{len(tabs)}: {target}")

    def close_tab():
        nonlocal tabs, tab_idx
        if len(tabs) <= 1:
            set_status("只剩一个标签页，无法关闭")
            return
        tabs.pop(tab_idx)
        if tab_idx >= len(tabs):
            tab_idx = len(tabs) - 1
        tab_load(tabs[tab_idx])
        set_status(f"已关闭，剩余 {len(tabs)} 个标签页")

    def open_tab_rename():
        nonlocal tab_name_buf, tab_name_cur, mode, dirty
        tab_name_buf = tab_title(tab_idx)
        tab_name_cur = len(tab_name_buf)
        mode = MODE_TABNAME
        dirty = True

    def apply_tab_rename():
        nonlocal mode, dirty
        nm = tab_name_buf.strip()
        if tab_idx < len(tabs) and tabs[tab_idx]:
            tabs[tab_idx]["name"] = nm
        else:
            tabs[tab_idx] = tabs[tab_idx] or {}
            tabs[tab_idx]["name"] = nm
        mode = MODE_LIST
        set_status(f"标签页 {tab_idx + 1} 重命名为: {nm}" if nm
                   else f"标签页 {tab_idx + 1} 恢复默认名称")
        dirty = True

    def tab_cycle_color(step=1):
        nonlocal dirty
        if tab_idx >= len(tabs):
            return
        if tabs[tab_idx] is None:
            tab_snapshot()
        cur = tab_color(tab_idx)
        newc = (cur + step) % len(TAB_COLOR_NAMES)
        tabs[tab_idx]["color"] = newc
        set_status(f"标签页 {tab_idx + 1} 颜色: {TAB_COLOR_NAMES[newc]}")
        dirty = True

    def close_specific_tab(i):
        nonlocal tabs, tab_idx
        if len(tabs) <= 1:
            set_status("只剩一个标签页，无法关闭")
            return
        if i == tab_idx:
            close_tab()
            return
        tabs.pop(i)
        if i < tab_idx:
            tab_idx -= 1
        set_status(f"已关闭标签页 {i + 1}，剩余 {len(tabs)} 个")

    def next_tab():
        switch_tab((tab_idx + 1) % len(tabs))

    def prev_tab():
        switch_tab((tab_idx - 1) % len(tabs))

