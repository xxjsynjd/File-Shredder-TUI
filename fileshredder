    DK_TREE = {"磁盘": {
        "磁盘检测（坏块/坏扇区）": [],
        "分区设备管理": ["创建分区…", "删除分区…", "重命名卷…", "设置分区大小…",
                        "设置MBR…", "刷新MBR", "切换分区表类型（MBR/GPT）…"],
    }}
    PART_ITEMS = DK_TREE["磁盘"]["分区设备管理"]
    # 柱面格状态：0 未检测 / 1 优秀 / 2 良好 / 3 正常 / 4 一般 / 5 欠佳 / 6 严重 / 7 损坏 / 8 已修复
    DK_GRADES = ("未检测", "优秀", "良好", "正常", "一般", "欠佳",
                 "严重", "损坏", "已修复")
    DK_MS_STEPS = ((12, 1), (25, 2), (50, 3), (100, 4), (250, 5))

    def dk_grade(ms_per_mib):
        """每 MiB 读取耗时(ms) → 档位；超过 250ms 记“严重”，读不出才是“损坏”"""
        for lim, g in DK_MS_STEPS:
            if ms_per_mib <= lim:
                return g
        return 6

    def dk_set_range(arg):
        """`:range 100-2000` 只扫这一段柱面；`:range all` 恢复全盘"""
        dk = DK
        a = (arg or "").strip().lower()
        if not a or a in ("all", "full", "全盘", "all-disk"):
            dk["cyl0"] = dk["cyl1"] = None
            dk["msg"] = "检测范围: 全盘"
            return
        nc = dk["ncells"] or 0
        try:
            if "-" in a:
                p1, p2 = a.split("-", 1)
                c0 = int(p1) if p1.strip() else 0
                c1 = int(p2) if p2.strip() else nc - 1
            else:
                c0 = c1 = int(a)
        except ValueError:
            dk["msg"] = "用法: :range 100-2000（柱面格号）或 :range all"
            return
        if nc:
            c0 = max(0, min(nc - 1, c0))
            c1 = max(0, min(nc - 1, c1))
        else:
            c0, c1 = max(0, c0), max(0, c1)
        if c1 < c0:
            c0, c1 = c1, c0
        dk["cyl0"], dk["cyl1"] = c0, c1
        dk["msg"] = f"检测范围: 柱面 {c0}-{c1}（共 {c1 - c0 + 1} 格）"

    def dk_map_cols(w):
        return max(10, w - 24)

    def dk_dev_path(name):
        for base in ("/dev/block", "/dev"):
            p2 = os.path.join(base, name)
            if os.path.exists(p2):
                return p2
        return os.path.join("/dev/block", name)

    def dk_size_of(name):
        for base in ("/sys/block", "/sys/class/block"):
            f = os.path.join(base, name, "size")
            try:
                with open(f, "r") as fh:
                    return int(fh.read().strip() or 0) * 512
            except (OSError, ValueError):
                continue
        return 0

    def dk_scan_disks():
        """列出块设备（跳过 loop/ram/zram 这些内存假设备）+ 分区"""
        dk = DK
        names = []
        try:
            for nm in sorted(os.listdir("/sys/block")):
                if nm.startswith(("loop", "ram", "zram", "dm-")):
                    continue
                names.append(nm)
        except OSError:
            names = []
        # /proc/partitions 兜底（容器里 /sys 可能不全）
        if not names:
            try:
                with open("/proc/partitions", "r") as fh:
                    for line in fh.readlines()[2:]:
                        parts = line.split()
                        if len(parts) >= 4:
                            n2 = parts[3]
                            if re.match(r"^(sd|mmcblk|nvme|vd|xvd)", n2) \
                                    and re.match(r"^(sd[a-z]+|mmcblk\d+|nvme\d+n\d+|vd[a-z]+|xvd[a-z]+)$", n2):
                                names.append(n2)
            except OSError:
                pass
        dk["disks"] = [(nm, dk_dev_path(nm), dk_size_of(nm)) for nm in names]
        # 诊断开关：FILESHREDDER_DEV=/path/to/file 时把它当一个"磁盘"来测（不碰真实设备）
        _dev = os.environ.get("FILESHREDDER_DEV", "").strip()
        if _dev and os.path.exists(_dev):
            dk["disks"].insert(0, ("(诊断文件)", _dev, os.path.getsize(_dev)))
        dk["disk_idx"] = 0
        dk_scan_parts()

    def dk_scan_parts():
        dk = DK
        if not dk["disks"]:
            dk["parts"] = []
            dk["part_idx"] = 0
            return
        nm = dk["disks"][dk["disk_idx"]][0]
        parts = []
        try:
            for sub in sorted(os.listdir(os.path.join("/sys/block", nm))):
                if sub == nm or not sub.startswith(nm[:12]):
                    continue
                if not os.path.isdir(os.path.join("/sys/block", nm, sub)):
                    continue
                if not re.match(r"^(mmcblk\d+p\d+|sd[a-z]+\d+|nvme\d+n\d+p\d+|vd[a-z]+\d+|xvd[a-z]+\d+)$", sub):
                    continue
                parts.append((sub, dk_dev_path(sub), dk_size_of(sub)))
        except OSError:
            pass
        if not parts:
            # 没有子分区就直接用整盘
            parts = [(nm, dk["disks"][dk["disk_idx"]][1], dk["disks"][dk["disk_idx"]][2])]
        dk["parts"] = parts
        dk["part_idx"] = 0

    def dk_cur_dev():
        dk = DK
        if not dk["parts"]:
            return "", 0
        nm, path, size = dk["parts"][min(dk["part_idx"], len(dk["parts"]) - 1)]
        return path, size

    def dk_fmt_size(n):
        for unit in ("B", "KB", "MB", "GB", "TB"):
            if n < 1024 or unit == "TB":
                return f"{n:.1f} {unit}" if unit != "B" else f"{int(n)} B"
            n /= 1024.0

    def dk_eta(dk):
        if dk["state"] != "running" or dk["speed"] <= 0:
            return ""
        left = max(0, dk["total"] - dk["off"])
        sec = left / dk["speed"]
        if sec < 60:
            return f"剩余 {int(sec)}s"
        if sec < 3600:
            return f"剩余 {int(sec // 60)}m{int(sec % 60):02d}s"
        return f"剩余 {int(sec // 3600)}h{int(sec % 3600 // 60):02d}m"

    def dk_start_scan():
        """ENTER：开始顺序读扫描。读失败=EIO 即记为坏块/坏扇区"""
        dk = DK
        if dk["state"] == "running":
            dk["msg"] = "正在扫描中（ESC 先停止）"
            return
        path, size = dk_cur_dev()
        if not path or not size:
            dk["msg"] = "没有可用的分区（先按 D 选磁盘）"
            return
        try:
            fh = open(path, "rb")
        except PermissionError:
            dk["state"] = "error"
            dk["msg"] = (f"读取被拒绝: {path} —— 需要 root。"
                         "Termux 里用 su 启动（su -c 'fileshredder'）")
            return
        except OSError as e:
            dk["state"] = "error"
            dk["msg"] = f"打不开 {path}：{getattr(e, 'strerror', None) or e}"
            return
        ncells = max(1, dk["ncells"] or 64)
        dk["cells"] = [0] * ncells
        dk["ncells"] = ncells
        span = max(1, size // ncells)
        dk["span"] = span
        # 检测范围：默认全盘；:range a-b 只扫 [a,b] 这一段柱面
        c0 = 0 if dk["cyl0"] is None else max(0, min(ncells - 1, dk["cyl0"]))
        c1 = (ncells - 1 if dk["cyl1"] is None
              else max(0, min(ncells - 1, dk["cyl1"])))
        if c1 < c0:
            c0, c1 = c1, c0
        r_start = c0 * span
        r_end = min(size, (c1 + 1) * span) if c1 < ncells - 1 else size
        dk["rng_start"] = r_start
        dk["total"] = r_end
        dk["off"] = r_start
        dk["bad"] = 0
        dk["ok"] = 0
        dk["bad_offsets"] = []
        dk["sel_cell"] = 0
        dk["state"] = "running"
        dk["stop"] = False
        dk["t0"] = time.time()
        dk["elapsed"] = 0.0
        dk["speed"] = 0.0
        dk["msg"] = ""
        block = dk["block"]

        def worker():
            f = fh
            off = r_start
            t0 = time.time()
            last_t = t0
            last_off = 0
            try:
                while off < r_end:
                    if dk["stop"]:
                        break
                    try:
                        f.seek(off)
                        _t_read = time.time()
                        data = f.read(block)
                        dt_ms = (time.time() - _t_read) * 1000.0
                    except OSError:
                        # 读失败（EIO）= 坏块/坏扇区：记一笔，跳过这一块继续往后扫
                        cell = min(ncells - 1, off // dk["span"])
                        bend = min(size, off + block)
                        c_end = min(ncells - 1, (bend - 1) // dk["span"])
                        for c in range(cell, c_end + 1):
                            dk["cells"][c] = 7          # 损坏：读都读不出来
                        dk["bad"] += 1
                        dk["bad_offsets"].append((cell, off))
                        off = bend
                        dk["off"] = off
                        continue
                    if not data:
                        break
                    n = len(data)
                    end = off + n
                    c0 = min(ncells - 1, off // dk["span"])
                    c1 = min(ncells - 1, (end - 1) // dk["span"])
                    # 按“每 MiB 耗时”归到 DG 的 7 档（越慢档位越低）
                    g = dk_grade(dt_ms * 1048576.0 / max(1, n))
                    for c in range(c0, c1 + 1):
                        v = dk["cells"][c]
                        if v == 0 or (v != 8 and g > v):
                            dk["cells"][c] = g
                    dk["ok"] += n
                    off = end
                    dk["off"] = off
                    now = time.time()
                    if now - last_t >= 0.5:
                        dk["speed"] = (off - last_off) / max(1e-6, now - last_t)
                        dk["elapsed"] = now - t0
                        last_t = now
                        last_off = off
            finally:
                try:
                    f.close()
                except OSError:
                    pass
                dk["elapsed"] = time.time() - dk["t0"]
                dk["state"] = "stopped" if dk["stop"] else "done"

        th = threading.Thread(target=worker, daemon=True)
        th.start()
        dk["thread"] = th

    def dk_repair_cell():
        """Ctrl+Enter / R：对选中柱面里记录到的坏块写零，尝试让 EMMC 重映射"""
        dk = DK
        cell = dk["sel_cell"]
        offs = [o for (c, o) in dk["bad_offsets"] if c == cell]
        if not offs:
            dk["msg"] = "这个柱面没有记录到坏块（先跑一遍扫描）"
            return
        path, _size = dk_cur_dev()
        try:
            fh = open(path, "r+b")
        except PermissionError:
            dk["msg"] = "写入被拒绝：修复需要 root（su -c 'fileshredder'）"
            return
        except OSError as e:
            dk["msg"] = f"打不开 {path}：{getattr(e, 'strerror', None) or e}"
            return
        n_ok = n_fail = 0
        try:
            for o in offs:
                try:
                    fh.seek(o)
                    fh.write(b"\x00" * min(dk["block"], 4096))
                    fh.flush()
                    os.fsync(fh.fileno())
                    n_ok += 1
                except OSError:
                    n_fail += 1
        finally:
            try:
                fh.close()
            except OSError:
                pass
        if n_ok:
            nc2 = len(dk["cells"])
            span = dk["span"] or 1
            for (c, o) in [(c, o) for (c, o) in dk["bad_offsets"] if c == cell]:
                c1 = min(nc2 - 1, (o + dk["block"] - 1) // span)
                for cc in range(c, c1 + 1):
                    dk["cells"][cc] = 8        # 已修复
            dk["bad"] = max(0, dk["bad"] - n_ok)
            dk["bad_offsets"] = [(c, o) for (c, o) in dk["bad_offsets"] if c != cell]
        dk["msg"] = (f"修复: 写入成功 {n_ok} 个块" +
                     (f"，失败 {n_fail} 个" if n_fail else "") +
                     "（原数据已丢失；坏块是否能被控制器重映射取决于硬件）")

    # ---------------- Root：分区设备管理 ----------------
    MBR_TYPES = {0x83: "Linux", 0x0B: "FAT32", 0x0C: "FAT32 LBA", 0x07: "NTFS/exFAT",
                 0x05: "扩展", 0x0F: "扩展 LBA", 0xEE: "GPT 保护", 0x82: "Linux swap",
                 0x06: "FAT16", 0x04: "FAT16", 0x01: "FAT12", 0xA5: "FreeBSD"}
    PM = {"sel": 0, "msg": "", "confirm": None, "pre": ""}
    PF = {"title": "", "fields": [], "sel": 0, "note": "", "cb": None}
    PX = {"desc": "", "cmds": [], "out": [], "state": "confirm", "warn": "",
          "soft": False, "back": ""}

    def pt_read(path):
        """纯 Python 解析分区表（不依赖 parted）：返回 (label, [分区字典])"""
        try:
            with open(path, "rb") as f:
                head = f.read(512)
                if len(head) < 512:
                    return ("none", [])
                if head[510:512] != b"\x55\xaa":
                    return ("none", [])
                if any(head[446 + i * 16 + 4] == 0xEE for i in range(4)):
                    f.seek(512)
                    hdr = f.read(92)
                    if len(hdr) < 92:
                        return ("gpt", [])
                    ent_lba = int.from_bytes(hdr[72:80], "little")
                    num = min(128, int.from_bytes(hdr[80:84], "little") or 0)
                    esz = int.from_bytes(hdr[84:88], "little") or 128
                    f.seek(ent_lba * 512)
                    parts = []
                    for i in range(num):
                        e = f.read(esz)
                        if not e or len(e) < 56:
                            break
                        if e[0:16] == b"\x00" * 16:
                            continue
                        parts.append({"num": i + 1,
                                      "lba0": int.from_bytes(e[32:40], "little"),
                                      "lba1": int.from_bytes(e[40:48], "little"),
                                      "type": "GPT", "tag": ""})
                    return ("gpt", parts)
                parts = []
                for i in range(4):
                    e = head[446 + i * 16:446 + (i + 1) * 16]
                    typ = e[4]
                    lba0 = int.from_bytes(e[8:12], "little")
                    cnt = int.from_bytes(e[12:16], "little")
                    if typ == 0 or cnt == 0:
                        continue
                    parts.append({"num": i + 1, "lba0": lba0, "lba1": lba0 + cnt - 1,
                                  "type": MBR_TYPES.get(typ, f"0x{typ:02X}"),
                                  "tag": ""})
                return ("msdos", parts)
        except (OSError, ValueError, IndexError) as e:
            return ("error", [{"num": 0, "lba0": 0, "lba1": 0,
                               "type": f"读取失败: {e}"[:16], "tag": ""}])

    def pt_refresh():
        dk = DK
        path, size = dk_cur_dev()
        if not path:
            dk["pt_label"], dk["pt_parts"] = "", []
            return
        lab, parts = pt_read(path)
        dk["pt_label"], dk["pt_parts"] = lab, parts

    def pt_dev_size(path):
        try:
            return os.path.getsize(path)
        except OSError:
            return 0

    def pt_parts_on_disk():
        """磁盘名 → /dev/block 下面按名字拼出来的分区（读不到就退回 sysfs）"""
        dk = DK
        if not dk["disks"]:
            return []
        nm, path, _sz = dk["disks"][min(dk["disk_idx"], len(dk["disks"]) - 1)]
        out = []
        for (_n2, p2, _s2) in dk["parts"]:
            out.append(p2)
        return out

    def pt_guard(path, destructive=True):
        """返回错误串；None = 放行"""
        dk = DK
        if not path:
            return "没有可用的磁盘（先按 D 选一个）"
        if not os.path.exists(path):
            return f"目标不存在: {path}"
        if os.path.isfile(path):
            return None                  # 诊断镜像文件，允许直接练手
        if not destructive:
            return None
        try:
            with open("/proc/mounts", "r", encoding="utf-8", errors="replace") as f:
                mounts = [ln.split()[0] for ln in f if ln.strip()]
        except OSError:
            mounts = []
        base = os.path.basename(path)
        for src in mounts:
            if src == path or src.startswith("/dev/" + base):
                return (f"磁盘上有分区正被挂载（{src}）：分区表一动就会毁数据，"
                        "先 umount 再操作")
        if os.geteuid() != 0:
            return "改分区表要 root：用 su 启动（su -c 'fileshredder'）"
        return None

    def pt_tool(names):
        for n in names:
            w = shutil.which(n)
            if w:
                return w
        return ""

    def px_begin(desc, cmds, warn="", soft=False, back=""):
        nonlocal mode, dirty
        PX["desc"], PX["cmds"], PX["warn"] = desc, [list(c) for c in cmds], warn
        PX["out"], PX["state"], PX["soft"] = [], "confirm", soft
        PX["back"] = back or MODE_PARTMNGR
        mode = MODE_PARTEXEC
        dirty = True

    def px_run():
        nonlocal dirty
        outs = []
        ok = True
        for c in PX["cmds"]:
            outs.append("$ " + " ".join(c))
            try:
                r = subprocess.run(c, capture_output=True, text=True, timeout=300)
            except (OSError, subprocess.SubprocessError) as e:
                outs.append(f"! 执行失败: {e}")
                ok = False
                break
            for ln in (r.stdout or "").strip().splitlines():
                outs.append("  " + ln)
            for ln in (r.stderr or "").strip().splitlines():
                # dd 之类把统计信息写 stderr，返回码 0 就别标成错误
                outs.append(("! " if r.returncode else "· ") + ln)
            if r.returncode != 0:
                if PX["soft"]:
                    outs.append("· 忽略（软操作）")
                    continue
                ok = False
                break
        PX["out"] = outs
        PX["state"] = "ok" if ok else "fail"
        dk_scan_disks()
        dk_scan_parts()
        pt_refresh()
        dirty = True

