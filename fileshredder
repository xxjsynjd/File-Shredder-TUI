PAT_PASS = re.compile(r"pass\s+(\d+)/(\d+)")
PAT_SIZE_OLD = re.compile(r"([+-]?\d+)([KMG])")
PAT_MTIME_OLD = re.compile(r"([+-]?\d+)")
PAT_SIZE_INTERVAL = re.compile(r"\[(.*?),(.*?)\]")
PAT_MDATE = re.compile(r"([<>]?=?)(\d{4}-\d{2}-\d{2})")

def shred_single_file_python(file_path, passes=2, chunk_size=1024*1024):
    if not os.path.isfile(file_path):
        yield (0, "skip:not a file"); return
    try:
        file_size = os.path.getsize(file_path)
        if file_size == 0:
            os.remove(file_path); yield (100, "OK:empty removed"); return
        with open(file_path, "r+b") as f:
            for pass_no in range(passes):
                f.seek(0); written = 0
                while written < file_size:
                    to_write = min(chunk_size, file_size - written)
                    f.write(secrets.token_bytes(to_write)); written += to_write
                    yield (int(written/file_size*100), f"Pass {pass_no+1}/{passes} writing")
                f.flush(); os.fsync(f.fileno())
        os.remove(file_path); yield (100, "✅ File shredded & deleted")
    except PermissionError:
        yield (-1, "❌ Permission denied")
    except Exception as e:
        yield (-1, f"❌ Error:{str(e)}")

def shred_single_file_system(file_path, passes=2, chunk_size=1024*1024):
    if not os.path.isfile(file_path):
        yield (0, "skip:not a file"); return
    try:
        if os.path.getsize(file_path) == 0:
            os.remove(file_path); yield (100, "OK:empty removed"); return
        proc = subprocess.Popen(
            ["shred", f"-n{passes}", "-u", "-z", "-v", file_path],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0, text=True)
        yield (0, f"Start shred pass={passes} (+zero pass)")
        while proc.poll() is None:
            line = proc.stderr.readline()
            if not line: continue
            m = PAT_PASS.search(line)
            if m:
                p_no, p_total = int(m.group(1)), int(m.group(2))
                yield (int(p_no/p_total*100), f"Pass {p_no}/{p_total} writing")
        ret = proc.wait(); proc.stderr.read(); proc.stdout.read()
        if ret == 0: yield (100, "✅ File shredded & deleted")
        else: yield (-1, f"❌ shred exited code {ret}")
    except FileNotFoundError:
        yield (-1, "❌ ERROR: shred not found, run pkg install coreutils")
    except PermissionError:
        yield (-1, "❌ Permission denied")
    except Exception as e:
        yield (-1, f"❌ Error:{str(e)}")

def shred_single_file(file_path, passes=2, chunk_size=1024*1024):
    if USE_SYSTEM_SHRED:
        yield from shred_single_file_system(file_path, passes, chunk_size)
    else:
        yield from shred_single_file_python(file_path, passes, chunk_size)

def collect_all_files(target_path):
    out, p = [], Path(target_path)
    if p.is_file(): return [str(p)]
    if p.is_dir():
        for root, _, files in os.walk(p):
            for fn in files:
                out.append(os.path.join(root, fn))
    return out

_unit_map = {"K":1024, "M":1024*1024, "G":1024**3}

def _parse_size_token(s):
    s = s.strip()
    if not s: return None
    m = PAT_SIZE_OLD.match(s)
    if not m: return None
    num, unit = m.groups()
    return abs(int(num))*_unit_map[unit]

def parse_size_interval_spec(spec):
    m = PAT_SIZE_INTERVAL.match(spec.strip())
    if not m: return None
    a, b = m.groups()
    return (_parse_size_token(a) if a.strip() else None,
            _parse_size_token(b) if b.strip() else None)

def parse_mdate_spec(spec):
    m = PAT_MDATE.match(spec.strip())
    if not m: return None
    op, datestr = m.groups()
    op = op or "="
    try:
        return (op, datetime.strptime(datestr, "%Y-%m-%d").timestamp())
    except ValueError:
        return None

def parse_mtime_spec(spec):
    m = PAT_MTIME_OLD.match(spec.strip())
    if not m: return None
    raw = spec.strip(); num = int(m.group(1))
    op = ">" if raw.startswith("+") else ("<" if raw.startswith("-") else "=")
    return (op, num)

# ============ RAW stdin reader: UTF-8 chars + ANSI keys + mouse reports ============
class RawKeyReader:
    def __init__(self):
        self.buf = b""
        self.fd = sys.stdin.fileno()

    def available(self):
        return bool(select.select([self.fd], [], [], 0.01)[0])

    def read_one(self):
        while self.available():
            c = os.read(self.fd, 1)
            if not c: return None
            self.buf += c

        if not self.buf:
            return None

        b0 = self.buf[0]

        # --- Mouse report: ESC [ < button ; x ; y M/m  (1006 mode) ---
        if self.buf.startswith(b"\x1b[<"):
            end = self.buf.find(b"M")
            end2 = self.buf.find(b"m")
            end_candidates = []
            if end != -1: end_candidates.append(end)
            if end2 != -1: end_candidates.append(end2)
            if not end_candidates:
                return None  # wait rest of report
            end = min(end_candidates)
            body = self.buf[3:end]
            self.buf = self.buf[end+1:]
            try:
                parts = body.split(b";")
                btn, x, y = int(parts[0]), int(parts[1]), int(parts[2])
                pressed = (self.buf[end] if end < len(self.buf) else b'') == ord("M")
                return ("MOUSE", btn, x, y, pressed)
            except Exception:
                return None

        # --- Arrow / other CSI: ESC [ letter ---
        if self.buf.startswith(b"\x1b["):
            if len(self.buf) < 3: return None
            seq = self.buf[:3]; self.buf = self.buf[3:]
            return {b"\x1b[A": "UP", b"\x1b[B": "DOWN",
                    b"\x1b[C": "RIGHT", b"\x1b[D": "LEFT"}.get(seq, "ESC")

        if b0 == 27:
            self.buf = self.buf[1:]; return "ESC"
        if b0 in (13, 10):
            self.buf = self.buf[1:]; return "ENTER"
        if b0 in (8, 127):
            self.buf = self.buf[1:]; return "BACKSPACE"

        if (b0 & 0x80) == 0:
            ch = self.buf[:1].decode("ascii"); self.buf = self.buf[1:]; return ch

        try:
            s = self.buf.decode("utf-8")
            ch = s[0]; self.buf = self.buf[len(ch.encode("utf-8")):]
            return ch
        except UnicodeDecodeError:
            return None  # incomplete multibyte, wait

def tui_main(stdscr):
    curses.curs_set(0)
    stdscr.keypad(False)
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    sys.stdout.write("\x1b[?1006h")
    sys.stdout.flush()

    global USE_SYSTEM_SHRED
    SHRED_PASSES = 2
    USE_SYSTEM_SHRED = True
    current_pwd = os.path.abspath("/storage/emulated/0/Download/shred_test")
    old_pwd = current_pwd

    original_scan_entries, scan_entries = [], []
    cursor_idx, selected_set, view_offset = 0, set(), 0
    search_mode, search_keyword, search_matches, current_match_idx = False, "", [], 0

    MODE_LIST, MODE_PREVIEW = "list", "preview"
    MODE_CONFIRM1, MODE_CONFIRM2 = "confirm1", "confirm2"
    MODE_SHREDDING, MODE_CMDLINE = "shredding", "cmdline"
    mode = MODE_LIST

    cmd_buffer, cmd_error = "", ""
    all_selected_entries, total_file_list = [], []
    total_file_count = current_global_idx = 0
    current_file_generator = None
    current_file_status, current_file_pct = "", 0

    btn_defs = [
        ("[Quit]", "quit"),
        ("[SelectAll]", "sel_all"),
        ("[ClearSel]", "clear_sel"),
        ("[Confirm]", "confirm"),
    ]
    key_reader = RawKeyReader()

    # ✅ Dirty标记：只有dirty=True才重绘屏幕，空闲循环跳过refresh
    dirty = True

    def rescan_directory():
        nonlocal original_scan_entries, scan_entries, cursor_idx, view_offset, dirty
        original_scan_entries.clear()
        parent_path = os.path.dirname(current_pwd.rstrip("/"))
        original_scan_entries.append({"path": parent_path, "name": ".. (GO UP)",
                                      "is_dir": True, "is_parent_link": True})
        try:
            for entry in os.listdir(current_pwd):
                fullp = os.path.join(current_pwd, entry)
                original_scan_entries.append({"path": fullp, "name": entry,
                    "is_dir": os.path.isdir(fullp), "is_parent_link": False})
        except PermissionError:
            pass
        scan_entries = original_scan_entries.copy()
        cursor_idx, view_offset = 0, 0
        selected_set.clear()
        dirty = True

    def compute_search_matches(kw):
        kw_low = kw.lower()
        return [i for i, e in enumerate(original_scan_entries) if kw_low in e["name"].lower()] if kw_low else []

    def goto_next_match():
        nonlocal cursor_idx, view_offset, current_match_idx, dirty
        if not search_matches: return
        current_match_idx = (current_match_idx + 1) % len(search_matches)
        cursor_idx = search_matches[current_match_idx]
        h, _ = stdscr.getmaxyx(); max_lines = (h-1)-4
        view_offset = cursor_idx if cursor_idx < view_offset else (cursor_idx - max_lines + 1) if cursor_idx >= view_offset+max_lines else view_offset
        dirty = True

    def goto_prev_match():
        nonlocal cursor_idx, view_offset, current_match_idx, dirty
        if not search_matches: return
        current_match_idx = (current_match_idx - 1) % len(search_matches)
        cursor_idx = search_matches[current_match_idx]
        h, _ = stdscr.getmaxyx(); max_lines = (h-1)-4
        view_offset = cursor_idx if cursor_idx < view_offset else (cursor_idx - max_lines + 1) if cursor_idx >= view_offset+max_lines else view_offset
        dirty = True

    def select_invert():
        nonlocal dirty
        for idx, ent in enumerate(original_scan_entries):
            if ent.get("is_parent_link"): continue
            selected_set.discard(idx) if idx in selected_set else selected_set.add(idx)
        dirty = True

    def select_multi_condition(raw_args):
        nonlocal dirty
        try: tokens = shlex.split(raw_args)
        except ValueError: return (0, "parse error: bad quote")
        name_pattern = want_type = size_interval = mtime_spec = mdate_spec = None
        i = 0
        while i < len(tokens):
            t = tokens[i]
            if t == "-t":
                i += 1
                if i >= len(tokens): return (0, "-t need f/d arg")
                v = tokens[i].lower()
                if v in ("f", "d"): want_type = v
                else: return (0, "-t only accept f or d")
            elif t == "-size":
                i += 1
                if i >= len(tokens): return (0, "-size need [min,max]")
                sp = parse_size_interval_spec(tokens[i])
                if sp is None: return (0, f"bad size spec:{tokens[i]}")
                size_interval = sp
            elif t == "-mtime":
                i += 1
                if i >= len(tokens): return (0, "-mtime need ±n days")
                mp = parse_mtime_spec(tokens[i])
                if mp is None: return (0, f"bad mtime spec:{tokens[i]}")
                mtime_spec = mp
            elif t == "-mdate":
                i += 1
                if i >= len(tokens): return (0, "-mdate need >YYYY-MM-DD")
                md = parse_mdate_spec(tokens[i])
                if md is None: return (0, f"bad mdate spec:{tokens[i]}")
                mdate_spec = md
            elif not t.startswith("-"):
                if name_pattern is None: name_pattern = t
                else: return (0, "multiple name pattern not supported")
            else:
                return (0, f"unknown flag {t}")
            i += 1

        hit, now = 0, time.time()
        for idx, ent in enumerate(original_scan_entries):
            if ent.get("is_parent_link"): continue
            ok = True
            if name_pattern is not None and name_pattern.lower() not in ent["name"].lower(): ok = False
            if want_type is not None and ok:
                if want_type == "f" and not os.path.isfile(ent["path"]): ok = False
                if want_type == "d" and not ent["is_dir"]: ok = False
            if size_interval is not None and ok:
                min_b, max_b = size_interval
                try: sz = os.stat(ent["path"]).st_size
                except Exception: sz = 0
                if min_b is not None and sz < min_b: ok = False
                if max_b is not None and sz > max_b: ok = False
            if mtime_spec is not None and ok:
                op, days = mtime_spec
                try: dd = (now - os.stat(ent["path"]).st_mtime)/86400.0
                except Exception: dd = 0
                if op == ">" and not dd > days: ok = False
                elif op == "<" and not dd < days: ok = False
            if mdate_spec is not None and ok:
                op, tts = mdate_spec
                try: fts = os.stat(ent["path"]).st_mtime
                except Exception: fts = 0
                if op == ">" and not fts > tts: ok = False
                elif op == "<" and not fts < tts: ok = False
                elif op == "=" and not int(fts/86400) == int(tts/86400): ok = False
            if ok: selected_set.add(idx); hit += 1
        dirty = True
        return (hit, f"selected {hit} items")

    rescan_directory()

    while True:
        # ========== 只有 dirty=True 才重绘屏幕，消除无意义刷屏 ==========
        if dirty:
            stdscr.erase()   # ✅ 重点：erase()替代clear()，不发送终端清屏序列，大幅减少闪烁
            h, w = stdscr.getmaxyx()
            btn_row = h - 1

            rendered_buttons = []
            bx = 0
            gap = 2
            for (bname, action) in btn_defs:
                b_len = len(bname)
                rendered_buttons.append({"name":bname, "action":action, "x1":bx, "x2":bx + b_len -1})
                bx += b_len + gap

            if mode == MODE_LIST:
                title = f"🔍 SEARCH | PWD: {current_pwd} | ENTER=confirm,ESC=cancel" if search_mode \
                        else f"📂 FileShredder | /搜索 :命令 n=下匹配 N=上匹配"
                stdscr.addstr(0, 0, title[:w-1], curses.A_BOLD)
                stdscr.addstr(1, 0, "-" * min(w, len(title)))
                max_lines = btn_row - 4
                if cursor_idx < view_offset: view_offset = cursor_idx
                if cursor_idx >= view_offset + max_lines: view_offset = cursor_idx - max_lines + 1
                for di in range(max_lines):
                    ri = view_offset + di
                    if ri >= len(scan_entries): break
                    ent = scan_entries[ri]
                    roi = original_scan_entries.index(ent)
                    marker = "[✓]" if roi in selected_set else "[ ]"
                    icon = "⬆️" if ent.get("is_parent_link") else ("📁" if ent["is_dir"] else "📄")
                    txt = f"{marker} {icon} {ent['name']}"
                    stdscr.addstr(2+di, 0, txt[:w-1], curses.A_REVERSE if ri == cursor_idx else curses.A_NORMAL)
                sy = btn_row - 1
                if search_mode:
                    stdscr.addstr(sy, 0, f"/{search_keyword}"[:w-1], curses.A_REVERSE)
                else:
                    stdscr.addstr(sy, 0, f"↑↓滚动 | 点击勾选 | Sel:{len(selected_set)} | Matches:{len(search_matches)}"[:w-1])
                for rb in rendered_buttons:
                    if rb["x1"] >= w: break
                    stdscr.addstr(btn_row, rb["x1"], rb["name"], curses.A_BOLD | curses.A_REVERSE)

            elif mode == MODE_PREVIEW:
                stdscr.addstr(0, 0, "📋 Preview selected items (Folders will RECURSIVELY shred)", curses.A_BOLD)
                stdscr.addstr(1, 0, "="*(w-1)); y = 2
                for ent in all_selected_entries:
                    if ent.get("is_parent_link"): continue
                    typ = "FOLDER(RECURSIVE)" if ent["is_dir"] else "FILE"
                    if y >= btn_row - 1: break
                    stdscr.addstr(y, 0, f"[{y-1}] {typ}: {ent['path']}"[:w-1]); y += 1
                stdscr.addstr(btn_row-1, 0, "ENTER → Confirm | ESC Back")
                stdscr.addstr(btn_row, 0, "[Quit]  [Back]"[:w-1], curses.A_BOLD | curses.A_REVERSE)

            elif mode == MODE_CONFIRM1:
                msg = "⚠️ FIRST CONFIRM: You are going to shred selected items!"
                warn = "Folders will recursively overwrite ALL inner files!"
                prompt = "Press ENTER to continue to SECOND confirmation, ESC cancel"
                stdscr.addstr(h//2-2, max(0,w//2-len(msg)//2), msg, curses.A_BOLD|curses.A_REVERSE)
                stdscr.addstr(h//2-1, max(0,w//2-len(warn)//2), warn)
                stdscr.addstr(h//2, max(0,w//2-len(prompt)//2), prompt)
                stdscr.addstr(btn_row, 0, "[Quit]  [Cancel]  [NextConfirm]"[:w-1], curses.A_BOLD|curses.A_REVERSE)

            elif mode == MODE_CONFIRM2:
                msg = "🚨 FINAL CONFIRM: DATA CANNOT BE RESTORED AFTER SHREDDING!"
                prompt = ">> ENTER START SHREDDING | ESC ABORT <<"
                stdscr.addstr(h//2-1, max(0,w//2-len(msg)//2), msg, curses.A_BOLD|curses.A_REVERSE)
                stdscr.addstr(h//2, max(0,w//2-len(prompt)//2), prompt)
                stdscr.addstr(btn_row, 0, "[Quit]  [Abort]  [START SHRED]"[:w-1], curses.A_BOLD|curses.A_REVERSE)

            elif mode == MODE_SHREDDING:
                split_x = w // 2
                stdscr.addstr(0, 0, "📌 Processing Path", curses.A_BOLD)
                stdscr.addstr(1, 0, "-"*(split_x-1)); left_h = btn_row-3
                if current_global_idx < len(total_file_list):
                    cp = total_file_list[current_global_idx]
                    stdscr.addstr(2, 0, f">>> {cp}"[:split_x-1], curses.A_REVERSE)
                    hy = 3
                    for hi in range(max(0, current_global_idx-(left_h-3)), current_global_idx):
                        stdscr.addstr(hy, 0, f"✓ {total_file_list[hi]}"[:split_x-1]); hy += 1
                        if hy >= left_h+2: break
                stdscr.addstr(0, split_x, "✅ Shred Status", curses.A_BOLD)
                stdscr.addstr(1, split_x, "-"*(w-split_x-1))
                gd, gt = current_global_idx, total_file_count
                gp = int(gd/gt*100) if gt else 0
                stdscr.addstr(2, split_x, f"Total: {gd}/{gt}  {gp}%")
                bw = w-split_x-4; bf = int(bw*gp/100)
                stdscr.addstr(3, split_x, f"[{'#'*bf}{'-'*(bw-bf)}]")
                stdscr.addstr(5, split_x, f"Current File: {current_file_pct}%")
                stdscr.addstr(6, split_x, f"Status: {current_file_status}")

            elif mode == MODE_CMDLINE:
                stdscr.addstr(0, 0, f"📂 Command mode | ESC cancel | cmd: {cmd_buffer}", curses.A_BOLD)
                if cmd_error: stdscr.addstr(1, 0, f"⚠️ {cmd_error}", curses.A_REVERSE)
                stdscr.addstr(btn_row, 0, f":{cmd_buffer}"[:w-1], curses.A_REVERSE)

            stdscr.refresh()
            dirty = False  # ✅ 绘制完成，重置dirty标记

        # ---- shred generator ：后台进度更新，自动置dirty ----
        if mode == MODE_SHREDDING:
            if current_global_idx >= total_file_count:
                stdscr.erase()
                stdscr.addstr(0, 0, "🎉 All shred tasks finished!", curses.A_BOLD)
                stdscr.addstr(2, 0, f"Total shredded files: {total_file_count}")
                stdscr.addstr(4, 0, "Press any key back to directory browser")
                stdscr.refresh()
                while key_reader.read_one() is None: time.sleep(0.03)
                rescan_directory(); search_mode = False
                search_keyword = ""; search_matches = []; mode = MODE_LIST
                continue
            if current_file_generator is None:
                current_file_generator = shred_single_file(total_file_list[current_global_idx], passes=SHRED_PASSES)
            try:
                current_file_pct, current_file_status = next(current_file_generator)
                dirty = True # 进度变更 → 需要重绘
            except StopIteration:
                current_global_idx += 1; current_file_generator = None
                current_file_pct, current_file_status = 0, "Waiting next file"
                dirty = True

        key = key_reader.read_one()
        if key is None:
            time.sleep(0.03); continue

        # ---- dispatch ----
        if isinstance(key, tuple) and key[0] == "MOUSE":
            _, btn, mx, my, pressed = key
            mx -= 1
            my -= 1

            if btn == 64:
                cursor_idx = max(0, cursor_idx-1); dirty = True; continue
            if btn == 65:
                cursor_idx = min(len(scan_entries)-1, cursor_idx+1); dirty = True; continue

            if mode == MODE_LIST:
                h, w = stdscr.getmaxyx()
                btn_row = h - 1
                rendered_buttons = []
                bx = 0
                gap = 2
                for (bname, action) in btn_defs:
                    b_len = len(bname)
                    rendered_buttons.append({"name":bname, "action":action, "x1":bx, "x2":bx + b_len -1})
                    bx += b_len + gap

                if my == btn_row:
                    for rb in rendered_buttons:
                        if rb["x1"] <= mx <= rb["x2"]:
                            action = rb["action"]
                            if action == "quit": return
                            elif action == "sel_all":
                                selected_set.clear()
                                for i, e in enumerate(original_scan_entries):
                                    if not e.get("is_parent_link"): selected_set.add(i)
                            elif action == "clear_sel": selected_set.clear()
                            elif action == "confirm":
                                if selected_set:
                                    all_selected_entries = [original_scan_entries[i] for i in sorted(selected_set)
                                        if not original_scan_entries[i].get("is_parent_link")]
                                    mode = MODE_PREVIEW
                            dirty = True
                            break
                elif not search_mode:
                    dl = my - 2
                    max_lines = btn_row - 4
                    if 0 <= dl < max_lines:
                        ci = view_offset + dl
                        if ci < len(scan_entries):
                            cursor_idx = ci
                            ri = original_scan_entries.index(scan_entries[ci])
                            if ri in selected_set:
                                selected_set.discard(ri)
                            else:
                                selected_set.add(ri)
                            dirty = True
            continue

        if mode == MODE_LIST:
            if search_mode:
                search_matches = compute_search_matches(search_keyword)
                dirty = True
                if key == "ESC": search_mode = False
                elif key == "ENTER":
                    search_mode = False
                    if search_matches: current_match_idx = 0; goto_next_match()
                elif key == "BACKSPACE": search_keyword = search_keyword[:-1]
                else: search_keyword += key
                continue

            if key == '/': search_mode = True; dirty = True
            elif key == "UP": cursor_idx = max(0, cursor_idx-1); dirty = True
            elif key == "DOWN": cursor_idx = min(len(scan_entries)-1, cursor_idx+1); dirty = True
            elif key == ' ':
                if scan_entries:
                    roi = original_scan_entries.index(scan_entries[cursor_idx])
                    selected_set.discard(roi) if roi in selected_set else selected_set.add(roi)
                    dirty = True
            elif key == "ENTER":
                if not scan_entries: continue
                ce = scan_entries[cursor_idx]
                if ce.get("is_parent_link"):
                    old_pwd, current_pwd = current_pwd, ce["path"]; rescan_directory()
                elif ce["is_dir"]:
                    old_pwd, current_pwd = current_pwd, ce["path"]; rescan_directory()
                else:
                    if not selected_set:
                        selected_set.add(original_scan_entries.index(ce))
                    all_selected_entries = [original_scan_entries[i] for i in sorted(selected_set)
                        if not original_scan_entries[i].get("is_parent_link", False)]
                    mode = MODE_PREVIEW
                    dirty = True
            elif key == 'q': return
            elif key == ':': mode = MODE_CMDLINE; cmd_buffer = ""; cmd_error = ""; dirty = True
            elif key == 'n': goto_next_match()
            elif key == 'N': goto_prev_match()

        elif mode == MODE_CMDLINE:
            if key == "ESC": mode = MODE_LIST; cmd_buffer = ""; cmd_error = ""; dirty = True
            elif key == "ENTER":
                parts = cmd_buffer.strip().split(maxsplit=1); cmd_error = ""
                if not parts: mode = MODE_LIST; dirty = True; continue
                cmd, rest = parts[0], parts[1] if len(parts) >= 2 else ""
                if cmd == "cd":
                    arg = rest.strip()
                    try:
                        target = old_pwd if arg == "-" else os.path.abspath(os.path.join(current_pwd, arg))
                        if os.path.isdir(target):
                            old_pwd, current_pwd = current_pwd, target; rescan_directory()
                        else: cmd_error = f"no such directory: {target}"
                    except Exception as e: cmd_error = str(e)
                elif cmd == "select":
                    arg = rest.strip()
                    if arg == "":
                        ent = original_scan_entries[cursor_idx]
                        if not ent.get("is_parent_link"):
                            selected_set.discard(cursor_idx) if cursor_idx in selected_set else selected_set.add(cursor_idx)
                            dirty = True
                    elif arg == "!": select_invert()
                    elif arg == "clear": selected_set.clear(); dirty = True
                    else:
                        _, cmd_error = select_multi_condition(arg)
                else:
                    cmd_error = f"unknown cmd: {cmd}, support: cd, select"
                if not cmd_error: mode = MODE_LIST
                dirty = True
            elif key == "BACKSPACE": cmd_buffer = cmd_buffer[:-1]; dirty = True
            else: cmd_buffer += key; dirty = True

        elif mode == MODE_PREVIEW:
            if key == "ENTER": mode = MODE_CONFIRM1; dirty = True
            elif key == "ESC": mode = MODE_LIST; dirty = True
        elif mode == MODE_CONFIRM1:
            if key == "ENTER": mode = MODE_CONFIRM2; dirty = True
            elif key == "ESC": mode = MODE_LIST; dirty = True
        elif mode == MODE_CONFIRM2:
            if key == "ENTER":
                total_file_list.clear()
                for ent in all_selected_entries:
                    total_file_list.extend(collect_all_files(ent["path"]))
                total_file_count = len(total_file_list); current_global_idx = 0
                mode = MODE_SHREDDING
                dirty = True
            elif key == "ESC": mode = MODE_LIST; dirty = True

