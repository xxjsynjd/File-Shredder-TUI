            return
        new = nav_idx + step
        while 0 <= new < len(nav_hist) and not os.path.isdir(nav_hist[new]):
            set_status(f"历史里的目录已不存在，跳过: {nav_hist[new]}")
            nav_hist.pop(new)
            if step < 0 and nav_idx > new:
                nav_idx -= 1
            if not (0 <= new < len(nav_hist)):
                return
        if not (0 <= new < len(nav_hist)):
            set_status("已经是第一个目录了" if step < 0 else "已经是最后一个目录了")
            dirty = True
            return
        nav_moving = True
        nav_idx = new
        old_pwd = current_pwd
        current_pwd = nav_hist[new]
        rescan_directory()
        nav_moving = False
        nav_seen = current_pwd
        set_status(f"{'← 返回' if step < 0 else '→ 前进'}: {current_pwd}  "
                   f"[{nav_idx + 1}/{len(nav_hist)}]")
        dirty = True

    def run_find():
        nonlocal find_hits, find_sel, find_note, mode, dirty
        q = find_query.strip()
        scope = FIND_SCOPES[max(0, min(len(FIND_SCOPES) - 1, find_scope_idx))]
        if not q:
            find_note = "请输入关键词（支持中文、* ? 通配、不区分大小写）"
            dirty = True
            return
        hits, scanned, truncated = folder_find(current_pwd, q, scope=scope)
        find_hits = hits
        find_sel = 0
        find_note = f"[{scope}] 「{q}」命中 {len(hits)} 项 / 扫描 {scanned} 项"
        if truncated:
            find_note += "（已达 800 上限，结果可能不全）"
        mode = MODE_FIND_RES
        dirty = True

    def find_window(max_lines):
        """搜索结果的滚动起点（保证 find_sel 可见）"""
        if not find_hits or max_lines < 1:
            return 0
        off = max(0, find_sel - max_lines + 1)
        return min(off, max(0, len(find_hits) - max_lines))

    def goto_find_hit(hit):
        nonlocal cursor_idx, view_offset, mode, dirty
        p = hit["path"]
        target = p if hit["is_dir"] else (os.path.dirname(p) or "/")
        if not safe_enter_dir(target):
            return
        mode = MODE_LIST
        found = False
        for i, e in enumerate(scan_entries):
            if e["path"] == p:
                cursor_idx = i
                selected_set.add(i)
                _scroll_to(i)
                found = True
                break
        if hit["is_dir"]:
            set_status(f"已进入目录: {p}")
        elif found:
            set_status(f"已定位并勾选: {os.path.basename(p)}")
        else:
            set_status(f"已进入 {target}，但目标已被移走")
        dirty = True

    def current_targets():
        ents, err = target_entries()
        if err:
            return [], err
        ents = [e for e in ents if not e.get("is_parent_link")]
        if not ents:
            return [], "请先选中一个文件/目录"
        return [e["path"] for e in ents], ""

