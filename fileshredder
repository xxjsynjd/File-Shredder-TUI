def human_size(num):
    """字节数 -> 人类可读（1024 进制）"""
    try:
        n = float(num)
    except (TypeError, ValueError):
        return "?"
    if n < 0:
        return "?"
    if n < 1024:
        return f"{int(n)} B"
    for unit in ("KB", "MB", "GB", "TB", "PB"):
        n /= 1024.0
        if n < 1024 or unit == "PB":
            return f"{n:.1f} {unit}"
    return f"{n:.1f} PB"


def unique_target(dirpath, name):
    """dest 里同名冲突时生成 “名字 (1).ext”，返回可用路径或 None"""
    target = os.path.join(dirpath, name)
    if not os.path.lexists(target):
        return target
    stem, ext = os.path.splitext(name)
    for i in range(1, 1000):
        cand = os.path.join(dirpath, f"{stem} ({i}){ext}")
        if not os.path.lexists(cand):
            return cand
    return None


def copy_path(src, dest_dir):
    """把单个文件/目录复制进 dest_dir，返回 (目标路径, 错误文本)"""
    name = os.path.basename(src.rstrip("/")) or "item"
    target = unique_target(dest_dir, name)
    if target is None:
        return None, f"{name}: 同名副本过多"
    try:
        if os.path.islink(src):
            os.symlink(os.readlink(src), target)
        elif os.path.isdir(src):
            shutil.copytree(src, target, symlinks=True)
        else:
            shutil.copy2(src, target)
    except PermissionError:
        return None, f"{name}: 无权限"
    except shutil.Error as e:
        return None, f"{name}: 部分文件复制失败（{len(e.args[0]) if e.args else 0} 项）"
    except OSError as e:
        return None, f"{name}: {getattr(e, 'strerror', None) or e}"
    return target, ""


def move_path(src, dest_dir):
    """把单个文件/目录移动到 dest_dir，返回 (目标路径, 错误文本)"""
    name = os.path.basename(src.rstrip("/")) or "item"
    target = unique_target(dest_dir, name)
    if target is None:
        return None, f"{name}: 同名副本过多"
    try:
        shutil.move(src, target)
    except PermissionError:
        return None, f"{name}: 无权限"
    except shutil.Error as e:
        return None, f"{name}: 移动失败（跨设备/权限）"
    except OSError as e:
        return None, f"{name}: {getattr(e, 'strerror', None) or e}"
    return target, ""


FIND_SCOPES = ("名称", "名称+路径", "文件内容")
FIND_CONTENT_MAXSIZE = 2 * 1024 * 1024   # 内容搜索只读 <= 2MB 的文件
FIND_CONTENT_MAXFILES = 2000             # 内容搜索最多读这么多个文件


def folder_find(root, query, limit=FIND_LIMIT, scope="名称", include_hidden=True):
    """在当前文件夹内全方位搜索 -> (hits, scanned, truncated)

    scope: 名称 / 名称+路径 / 文件内容
    名称 支持 * ? [] 通配（不带通配符时按子串匹配，忽略大小写）
    """
    q = (query or "").strip()
    if not q:
        return [], 0, False
    needle = q.lower()
    use_glob = scope != "文件内容" and any(ch in q for ch in "*?[")
    pat = re.compile(fnmatch.translate(q), re.IGNORECASE) if use_glob else None
    content_scope = (scope == "文件内容")
    hits, scanned, truncated, files_read = [], 0, False, 0
    for base, dirs, files in os.walk(root):
        if not include_hidden:
            dirs[:] = [d for d in dirs if not d.startswith(".")]
        dirs.sort(key=str.lower)
        for nm in dirs + files:
            scanned += 1
            full = os.path.join(base, nm)
            is_dir = nm in dirs
            matched = False
            if content_scope:
                if not is_dir and files_read < FIND_CONTENT_MAXFILES:
                    files_read += 1
                    try:
                        if 0 < os.path.getsize(full) <= FIND_CONTENT_MAXSIZE:
                            with open(full, "rb") as f:
                                blob = f.read().decode("utf-8", "ignore")
                            matched = needle in blob.lower()
                    except (OSError, UnicodeError):
                        matched = False
            elif pat is not None:
                matched = bool(pat.search(nm))
            else:
                matched = needle in nm.lower()
            if not matched and scope == "名称+路径":
                try:
                    rel = os.path.relpath(full, root).lower()
                except ValueError:
                    rel = full.lower()
                # 相对路径、绝对路径、以及"上级目录/名字"三种写法都认
                matched = (needle in rel or needle in full.lower()
                           or needle in os.path.basename(base).lower() + "/" + nm.lower())
            if matched:
                hits.append({"path": full, "name": nm, "is_dir": is_dir})
            if len(hits) >= limit:
                return hits, scanned, True
    return hits, scanned, truncated


def fmt_time(ts):
    try:
        return datetime.fromtimestamp(ts).strftime("%Y-%m-%d %H:%M:%S")
    except (OSError, OverflowError, ValueError):
        return "-"


def perm_text(st):
    """-rwxr-xr-x (0755)"""
    import stat as _stat
    return f"{_stat.filemode(st.st_mode)} ({oct(st.st_mode & 0o777)[2:]})"


def dir_usage(path, limit=300000):
    """目录递归大小与条目数（受条目上限保护），返回 (bytes, items)"""
    total, items = 0, 0
    for base, dirs, files in os.walk(path):
        for nm in dirs + files:
            items += 1
            try:
                total += os.lstat(os.path.join(base, nm)).st_size
            except OSError:
                pass
            if items >= limit:
                return total, items
    return total, items


