        ("[Quit]", "quit"),
        ("[SelectAll]", "sel_all"),
        ("[ClearSel]", "clear_sel"),
        ("[Confirm]", "confirm"),
    ]
    key_reader = RawKeyReader()

    def put(y, x, text, attr=0, maxcols=None):
        h, w = stdscr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        if maxcols is None:
            maxcols = w - x - 1
        try:
            stdscr.addstr(y, x, clip(text, max(maxcols, 0)), attr)
        except curses.error:
            pass

    def set_status(msg):
        nonlocal status_msg, dirty
        status_msg = msg
        dirty = True

    def scan_dir(path):
        """返回 (entries, err)。目录不可用/已镂空时 err 非空，绝不抛异常。"""
        entries = []
        parent_path = os.path.dirname(path.rstrip("/")) or "/"
        entries.append({"path": parent_path, "name": ".. (GO UP)",
                        "is_dir": True, "is_parent_link": True})
        try:
            names = os.listdir(path)
        except FileNotFoundError:
            return None, "路径不存在（可能已被删除或移动）"
        except NotADirectoryError:
            return None, "目标不是文件夹"
        except PermissionError:
            return None, "无权限访问该目录"
        except OSError as e:
            return None, f"无法访问（{getattr(e, 'strerror', None) or e}）"

        for name in sorted(names, key=lambda s: s.lower()):
            fullp = os.path.join(path, name)
            try:
                is_dir = os.path.isdir(fullp)
                if not is_dir:
                    # 幽灵条目检测：listdir 之后又被删除的，直接不显示
                    os.stat(fullp)
            except OSError:
                continue
            entries.append({"path": fullp, "name": name,
                            "is_dir": is_dir, "is_parent_link": False})
        return entries, ""

    def rescan_directory():
        nonlocal original_scan_entries, scan_entries, cursor_idx, view_offset
        nonlocal current_pwd, status_msg, dirty

        # ① 当前目录镂空检测：逐级向上找最近可用目录
        fallback_from = None
        p = current_pwd
        guard = 0
        while not os.path.isdir(p) and guard < 256:
            if fallback_from is None:
                fallback_from = p
            parent = os.path.dirname(p.rstrip("/")) or "/"
            if parent == p:
                break
            p = parent
            guard += 1

        if not os.path.isdir(p):
            current_pwd = "/"
            original_scan_entries.clear()
            original_scan_entries.append({"path": "/", "name": ".. (GO UP)",
                                          "is_dir": True, "is_parent_link": True})
            scan_entries = original_scan_entries.copy()
            cursor_idx = 0
            view_offset = 0
            selected_set.clear()
            set_status(f"路径不存在: {fallback_from or current_pwd}")
            return

        rollback_note = ""
        if p != current_pwd:
            rollback_note = f"原路径已不存在: {fallback_from}"
            current_pwd = p

        # ② 扫描目录
        entries, err = scan_dir(current_pwd)
        if entries is None:
            parent = os.path.dirname(current_pwd.rstrip("/")) or "/"
            if parent != current_pwd and os.path.isdir(parent):
                current_pwd = parent
                entries, err = scan_dir(current_pwd)
                if entries is not None:
                    rollback_note = (rollback_note + "；" if rollback_note else "") + \
                                    f"{err} → 已回退到 {current_pwd}"
            if entries is None:
                current_pwd = "/"
                original_scan_entries.clear()
                original_scan_entries.append({"path": "/", "name": ".. (GO UP)",
                                              "is_dir": True, "is_parent_link": True})
                scan_entries = original_scan_entries.copy()
                cursor_idx = 0
                view_offset = 0
                selected_set.clear()
                set_status(f"{err}；已回到根目录")
                return

        original_scan_entries.clear()
        original_scan_entries.extend(entries)
        scan_entries = original_scan_entries.copy()
        cursor_idx = 0
        view_offset = 0
        selected_set.clear()
        if rollback_note:
            set_status(rollback_note)
        else:
            status_msg = ""
        dirty = True

    def safe_enter_dir(target):
        """进入目录前先做镂空检测，失败只提示不崩溃"""
        nonlocal current_pwd, old_pwd, status_msg, dirty
        if not target:
            set_status("路径为空，无法进入")
            return False
        if not os.path.exists(target):
            set_status(f"文件夹不存在或已被删除: {target}")
            return False
        if not os.path.isdir(target):
            set_status(f"目标不是文件夹: {target}")
            return False
        try:
            os.listdir(target)
        except PermissionError:
            set_status(f"无权限访问: {target}")
            return False
        except OSError as e:
            set_status(f"无法访问: {target}（{getattr(e, 'strerror', None) or e}）")
            return False
        old_pwd = current_pwd
        current_pwd = target
        status_msg = ""
        rescan_directory()
        return True

    def compute_search_matches(kw):
        kw_low = kw.lower()
        if not kw_low:
            return []
        return [i for i, e in enumerate(original_scan_entries)
                if kw_low in e["name"].lower()]

    def _scroll_to(idx):
        nonlocal view_offset, dirty
        h, _ = stdscr.getmaxyx()
        max_lines = (h - 1) - 4
        if max_lines < 1:
            max_lines = 1
        if idx < view_offset:
            view_offset = idx
        elif idx >= view_offset + max_lines:
            view_offset = idx - max_lines + 1
        dirty = True

    def goto_next_match():
        nonlocal cursor_idx, current_match_idx
        if not search_matches:
            return
        current_match_idx = (current_match_idx + 1) % len(search_matches)
        cursor_idx = search_matches[current_match_idx]
        _scroll_to(cursor_idx)

    def goto_prev_match():
        nonlocal cursor_idx, current_match_idx
        if not search_matches:
            return
        current_match_idx = (current_match_idx - 1) % len(search_matches)
        cursor_idx = search_matches[current_match_idx]
        _scroll_to(cursor_idx)

    def select_invert():
        nonlocal dirty
        for idx, ent in enumerate(original_scan_entries):
            if ent.get("is_parent_link"):
                continue
            if idx in selected_set:
                selected_set.discard(idx)
            else:
                selected_set.add(idx)
        dirty = True

    def select_multi_condition(raw_args):
        nonlocal dirty
        try:
            tokens = shlex.split(raw_args)
        except ValueError:
            return (0, "parse error: bad quote")
        name_pattern = want_type = size_interval = mtime_spec = mdate_spec = None
        i = 0
        while i < len(tokens):
            t = tokens[i]
            if t == "-t":
                i += 1
                if i >= len(tokens):
                    return (0, "-t need f/d arg")
                v = tokens[i].lower()
                if v in ("f", "d"):
                    want_type = v
                else:
                    return (0, "-t only accept f or d")
            elif t == "-size":
                i += 1
                if i >= len(tokens):
                    return (0, "-size need [min,max]")
                sp = parse_size_interval_spec(tokens[i])
                if sp is None:
                    return (0, f"bad size spec:{tokens[i]}")
                size_interval = sp
            elif t == "-mtime":
                i += 1
                if i >= len(tokens):
                    return (0, "-mtime need ±n days")
                mp = parse_mtime_spec(tokens[i])
                if mp is None:
                    return (0, f"bad mtime spec:{tokens[i]}")
                mtime_spec = mp
            elif t == "-mdate":
                i += 1
                if i >= len(tokens):
                    return (0, "-mdate need >YYYY-MM-DD")
                md = parse_mdate_spec(tokens[i])
                if md is None:
                    return (0, f"bad mdate spec:{tokens[i]}")
                mdate_spec = md
            elif not t.startswith("-"):
                if name_pattern is None:
                    name_pattern = t
                else:
                    return (0, "multiple name pattern not supported")
            else:
                return (0, f"unknown flag {t}")
            i += 1

        hit = 0
        now = time.time()
        for idx, ent in enumerate(original_scan_entries):
            if ent.get("is_parent_link"):
                continue
            if not os.path.exists(ent["path"]):
                continue
            ok = True
            if name_pattern is not None and name_pattern.lower() not in ent["name"].lower():
                ok = False
            if want_type is not None and ok:
                if want_type == "f" and not os.path.isfile(ent["path"]):
                    ok = False
                if want_type == "d" and not ent["is_dir"]:
                    ok = False
            if size_interval is not None and ok:
                min_b, max_b = size_interval
                try:
                    sz = os.stat(ent["path"]).st_size
                except OSError:
                    ok = False
                    sz = 0
                if ok:
                    if min_b is not None and sz < min_b:
                        ok = False
                    if max_b is not None and sz > max_b:
                        ok = False
            if mtime_spec is not None and ok:
                op, days = mtime_spec
                try:
                    dd = (now - os.stat(ent["path"]).st_mtime) / 86400.0
                except OSError:
                    ok = False
                    dd = 0
                if ok:
                    if op == ">" and not dd > days:
                        ok = False
                    elif op == "<" and not dd < days:
                        ok = False
            if mdate_spec is not None and ok:
                op, tts = mdate_spec
                try:
                    fts = os.stat(ent["path"]).st_mtime
                except OSError:
                    ok = False
                    fts = 0
                if ok:
                    if op == ">" and not fts > tts:
                        ok = False
                    elif op == "<" and not fts < tts:
                        ok = False
                    elif op == "=" and not int(fts / 86400) == int(tts / 86400):
                        ok = False
            if ok:
                selected_set.add(idx)
                hit += 1
        dirty = True
        return (hit, f"selected {hit} items")

