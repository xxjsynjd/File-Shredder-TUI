    def launch_program(prefix, wait_it=True, cwd=None, tgts=None,
                       append_targets=True):
        """用 prefix（[程序, 固定参数...]）打开 targets（默认当前选中项）"""
        nonlocal mode, dirty
        targets = tgts or ow_targets or [ow_path]
        if not prefix:
            return
        prog_name = os.path.basename(prefix[0])
        if not wait_it:
            # 交给系统/图形界面（termux-open、xdg-open、am start）：不等待、不接管终端
            # 批量时逐个文件分别拉起（这类程序通常一次只吃一个路径）
            fails = 0
            for t in targets:
                try:
                    subprocess.Popen(list(prefix) + ([t] if append_targets else []),
                                     stdin=subprocess.DEVNULL,
                                     stdout=subprocess.DEVNULL,
                                     stderr=subprocess.DEVNULL,
                                     start_new_session=True,
                                     cwd=(cwd or None))
                except (OSError, ValueError):
                    fails += 1
            if fails:
                set_status(f"批量打开：{fails}/{len(targets)} 项启动失败")
            else:
                set_status(f"已交给「{prog_name}」打开 {len(targets)} 项")
            mode = MODE_LIST
            dirty = True
            return
        argv = list(prefix) + (list(targets) if append_targets else [])
        # 交出终端：endwin 恢复 cooked 模式，让 less/nano/mpv 正常接管
        try:
            curses.def_prog_mode()
            curses.endwin()
        except curses.error:
            pass
        rc = 0
        try:
            sys.stdout.write("\x1b[?1006l\x1b[?1000l\x1b[?25h")
            sys.stdout.flush()
            rc = subprocess.call(argv,
                                 cwd=(cwd or os.path.dirname(targets[0]) or None))
        except (OSError, ValueError) as exc:
            rc = -1
            print(f"\n启动失败: {exc}")
            time.sleep(1.2)
        finally:
            try:
                curses.reset_prog_mode()
                curses.mousemask(curses.ALL_MOUSE_EVENTS)
                sys.stdout.write("\x1b[?1006h")
                sys.stdout.flush()
                curses.curs_set(0)
            except curses.error:
                pass
            stdscr.erase()
            stdscr.refresh()
            mode = MODE_LIST
            dirty = True
            if len(targets) == 1:
                set_status(f"已用「{prog_name}」打开 "
                           f"{os.path.basename(targets[0])}（退出码 {rc}）")
            else:
                set_status(f"已用「{prog_name}」批量打开 "
                           f"{len(targets)} 项（退出码 {rc}）")

