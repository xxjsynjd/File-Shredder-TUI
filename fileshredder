    def do_complete():
        """Tab 键：先补命令名，cd 的参数走路径补全；多候选弹菜单选"""
        nonlocal cmd_buffer, cmd_cur, cmd_note, dirty
        buf = cmd_buffer
        if " " not in buf:
            cands = [c for c in CMD_CANDIDATES if c.startswith(buf.lower()) or c.startswith(buf)]
            if not cands:
                cmd_note = f"无命令补全: {buf}"
            elif len(cands) == 1:
                cmd_buffer = cands[0] + " "
                cmd_cur = len(cmd_buffer)
                cmd_note = f"补全 → {cands[0]}"
            else:
                common = os.path.commonprefix(cands)
                if len(common) > len(buf):
                    cmd_buffer = common
                    cmd_cur = len(cmd_buffer)
                cmd_note = ""
                open_pick("命令补全", [(c, c + " ") for c in cands], "complete", "")
            dirty = True
            return

        head, _, arg = buf.partition(" ")
        if head.strip().lower() != "cd":
            cmd_note = f"只有 cd 的路径支持 Tab 补全（当前: {head.strip()}）"
            dirty = True
            return
        newarg, items, msg = path_complete(arg)
        if newarg is not None:
            cmd_buffer = head + " " + newarg
            cmd_cur = len(cmd_buffer)
        if len(items) > 1:
            cmd_note = ""
            open_pick(f"路径补全: {arg or '/'}", items, "complete", head + " ")
        else:
            cmd_note = msg
        dirty = True

