def folder_stats(path):
    """文件夹直下一层的统计：文件数/目录数/总条目 + 所在分区剩余空间"""
    files = dirs = 0
    try:
        with os.scandir(path) as it:
            for _e in it:
                if _e.is_dir(follow_symlinks=False):
                    dirs += 1
                else:
                    files += 1
    except OSError:
        pass
    free = total = None
    try:
        st = os.statvfs(path)
        free = st.f_bavail * st.f_frsize
        total = st.f_blocks * st.f_frsize
    except OSError:
        pass
    return files, dirs, free, total


def props_lines(paths):
    """为选中项生成属性面板文本行"""
    lines = []
    head_count = len(paths)
    if head_count > 1:
        total = items = 0
        for p in paths:
            try:
                if os.path.isdir(p) and not os.path.islink(p):
                    b, n = dir_usage(p)
                    total += b
                    items += n
                else:
                    total += os.lstat(p).st_size
                    items += 1
            except OSError:
                pass
        lines.append(f"Selection     : {head_count} item(s)")
        lines.append(f"Total size    : {human_size(total)}  ({total} bytes)")
        lines.append(f"Items inside  : {items}")
        lines.append("")
    for p in paths[:12]:
        name = os.path.basename(p.rstrip("/")) or p
        lines.append(f"── {name}")
        try:
            lst = os.lstat(p)
        except OSError as e:
            lines.append(f"   status      : 无法读取（{getattr(e, 'strerror', None) or e}）")
            continue
        is_link = os.path.islink(p)
        is_dir = os.path.isdir(p) and not is_link
        kind = "目录" if is_dir else ("符号链接" if is_link else "文件")
        lines.append(f"   type        : {kind}")
        lines.append(f"   path        : {p}")
        if is_link:
            try:
                lines.append(f"   link to     : {os.readlink(p)}")
            except OSError:
                pass
        if is_dir:
            b, n = dir_usage(p)
            lines.append(f"   size        : {human_size(b)}  ({b} bytes, {n} items)")
            files, dirs, free, total = folder_stats(p)
            lines.append(f"   contents    : {files} 文件 / {dirs} 目录")
            if free is not None:
                lines.append(f"   disk free   : {human_size(free)} / {human_size(total)}"
                             f"  ({100.0 * free / total:.0f}% 可用)")
        else:
            lines.append(f"   size        : {human_size(lst.st_size)}  ({lst.st_size} bytes)")
        lines.append(f"   permission  : {perm_text(lst)}")
        lines.append(f"   owner/group : {lst.st_uid} / {lst.st_gid}")
        lines.append(f"   modified    : {fmt_time(lst.st_mtime)}")
        lines.append(f"   accessed    : {fmt_time(lst.st_atime)}")
        lines.append(f"   inode/links : {lst.st_ino} / {lst.st_nlink}")
        parent = os.path.dirname(p.rstrip("/")) or "/"
        try:
            lines.append(f"   parent dir  : {parent} (writable={os.access(parent, os.W_OK)})")
        except OSError:
            pass
        lines.append("")
    if head_count > 12:
        lines.append(f"… 其余 {head_count - 12} 项略")
    return lines


def pick_start_dir(start_mode, argv_dir):
    """按策略挑选启动目录 -> (目录, 来源说明)

    default=默认路径 / argv=命令行指定 / cwd=当前目录 / last=上次运行目录
    显式命令行路径永远优先（此时来源记为命令行参数）。
    """
    if argv_dir:
        return argv_dir, "命令行参数"
    if start_mode not in START_MODES:
        start_mode = "default"
    if start_mode == "cwd":
        return os.getcwd(), "当前目录"
    if start_mode == "last":
        last = PREFS.get("last_dir")
        if last:
            return last, "上次运行目录"
        return PREFS.get("default_dir"), "上次运行目录(未记录→默认路径)"
    if start_mode == "argv":
        return PREFS.get("default_dir"), "默认路径(本次未给命令行参数)"
    return PREFS.get("default_dir"), "默认路径"


def resolve_start_path(raw):
    """解析命令行路径 -> (目录, 预选文件或None, 提示信息)

    规则：
      · 目录 → 直接从该目录启动
      · 文件 → 进入它所在目录，并预勾选这个文件
      · 不存在 → 逐级向上回退到最近存在的父目录，返回提示，绝不抛异常
    """
    raw = (raw or "").strip()
    if not raw:
        return None, None, ""
    p = os.path.abspath(os.path.expanduser(raw))
    if os.path.isfile(p):
        return (os.path.dirname(p) or "/"), p, ""
    if os.path.isdir(p):
        return p, None, ""
    miss = p
    guard = 0
    while not os.path.isdir(p) and guard < 256:
        parent = os.path.dirname(p.rstrip("/")) or "/"
        if parent == p:
            break
        p = parent
        guard += 1
    if os.path.isdir(p):
        return p, None, f"启动路径不存在: {miss} → 已改用 {p}"
    return None, None, f"启动路径不存在: {miss}"


# ============ RAW stdin reader: UTF-8 chars + ANSI keys + mouse reports ============
class RawKeyReader:
    def __init__(self):
        self.buf = b""
        self.fd = sys.stdin.fileno()

    def available(self):
        return bool(select.select([self.fd], [], [], 0.01)[0])

    def read_one(self):
        while self.available():
            c = os.read(self.fd, 1)
            if not c:
                return None
            self.buf += c

        if not self.buf:
            return None

        # ESC 单独按下 vs ESC 引导的 Alt 组合：留 20ms 看看后面还有没有字节
        if self.buf == b"\x1b":
            if select.select([self.fd], [], [], 0.02)[0]:
                try:
                    more = os.read(self.fd, 32)
                except OSError:
                    more = b""
                if more:
                    self.buf += more

        b0 = self.buf[0]

        # --- Alt + Backspace / Enter（Termux 发 ESC 前缀）---
        if self.buf.startswith(b"\x1b\x7f") or self.buf.startswith(b"\x1b\x08"):
            self.buf = self.buf[2:]
            return "ALT_BS"
        if self.buf.startswith(b"\x1b\r") or self.buf.startswith(b"\x1b\n"):
            self.buf = self.buf[2:]
            return "ALT_ENTER"

        # --- Alt + 字母（Termux 发 ESC 前缀）：ESC + 可打印字符 → ALT_X ---
        if self.buf.startswith(b"\x1b") and len(self.buf) > 1:
            nxt = self.buf[1:2]
            if 32 <= nxt[0] < 127 and nxt != b"[":
                self.buf = self.buf[2:]
                return "ALT_" + chr(nxt[0]).upper()

        # --- Mouse report: ESC [ < button ; x ; y M/m  (1006 mode) ---
        double_esc = self.buf.startswith(b"\x1b\x1b")

        if self.buf.startswith(b"\x1b\x1b"):
            self.buf = self.buf[1:]   # 只留一个引导 ESC，继续按 CSI 解析

        if self.buf.startswith(b"\x1b[<"):
            endM = self.buf.find(b"M")
            endm = self.buf.find(b"m")
            cands = [x for x in (endM, endm) if x != -1]
            if not cands:
                return None
            end = min(cands)
            body = self.buf[3:end]
            pressed = (self.buf[end:end + 1] == b"M")
            self.buf = self.buf[end + 1:]
            try:
                parts = body.split(b";")
                btn, x, y = int(parts[0]), int(parts[1]), int(parts[2])
                return ("MOUSE", btn, x, y, pressed)
            except Exception:
                return None

        # --- CSI（可能带参数）：ESC[1;3D / ESC[5~ 等 ---
        if self.buf.startswith(b"\x1b["):
            i = 2
            while i < len(self.buf) and not (0x40 <= self.buf[i] <= 0x7e):
                i += 1
            if i >= len(self.buf):
                return None          # 序列还没收完
            seq = self.buf[:i + 1]
            self.buf = self.buf[i + 1:]
            final = chr(seq[-1])
            params = seq[2:-1].decode("ascii", "ignore")
            mod = 1
            if ";" in params:
                parts_mod = params.split(";")
                try:
                    mod = int(parts_mod[1] or 1)
                except ValueError:
                    mod = 1
            arrow = {"A": "UP", "B": "DOWN", "C": "RIGHT", "D": "LEFT"}.get(final)
            if arrow:
                # 修饰符 3/4/5/6/7/8 = Alt/Alt+Shift/Ctrl/Ctrl+Shift/Ctrl+Alt/...
                return ("ALT_" + arrow) if (mod >= 3 or double_esc) else arrow
            if final == "H":
                return ("ALT_HOME" if (mod >= 3 or double_esc) else "HOME")
            if final == "F":
                return ("ALT_END" if (mod >= 3 or double_esc) else "END")
            pnum = params.rstrip("~")
            if final == "~":
                special = {"1": "HOME", "2": "INS", "3": "DELETE",
                           "4": "END", "5": "PGUP", "6": "PGDN",
                           "7": "HOME", "8": "END"}.get(pnum)
                if special:
                    return special
            return "ESC"

        if b0 == 27:
            self.buf = self.buf[1:]
            return "ESC"
        if b0 in (13, 10):
            self.buf = self.buf[1:]
            return "ENTER"
        if b0 in (8, 127):
            self.buf = self.buf[1:]
            return "BACKSPACE"

        if (b0 & 0x80) == 0:
            ch = self.buf[:1].decode("ascii")
            self.buf = self.buf[1:]
            return ch

        try:
            s = self.buf.decode("utf-8")
            ch = s[0]
            self.buf = self.buf[len(ch.encode("utf-8")):]
            return ch
        except UnicodeDecodeError:
            return None


def tui_main(stdscr):
    curses.curs_set(0)
    # raw()：让 ^C / ^X / ^V / ^F 这些控制字符进到读键逻辑，
    # 而不是被内核当成 SIGINT。curses 退出时 endwin 会自动还原终端。
    try:
        curses.raw()
    except curses.error:
        pass
    stdscr.keypad(False)
    curses.mousemask(curses.ALL_MOUSE_EVENTS)
    try:
        if curses.has_colors():
            curses.start_color()
            try:
                curses.use_default_colors()
                bgc = -1
            except curses.error:
                bgc = curses.COLOR_BLACK
            for k, fg in enumerate((curses.COLOR_GREEN, curses.COLOR_YELLOW,
                                    curses.COLOR_CYAN, curses.COLOR_MAGENTA,
                                    curses.COLOR_RED, curses.COLOR_CYAN)):
                curses.init_pair(41 + k, fg, bgc)
    except curses.error:
        pass
    sys.stdout.write("\x1b[?1006h")
    sys.stdout.flush()

    global USE_SYSTEM_SHRED
    USE_SYSTEM_SHRED = bool(PREFS.get("use_system_shred", True))

    # 启动目录策略：default=默认路径 / argv=命令行指定 / cwd=当前目录 / last=上次运行目录
    start_mode = PREFS.get("start_mode", "last")
    if start_mode not in START_MODES:
        start_mode = "default"
