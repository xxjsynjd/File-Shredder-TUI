PROG_LIST_CACHE = []


def system_programs(refresh=False):
    """扫描 PATH（含 Termux 的 $PREFIX/bin）里的可执行文件 -> [(名字, 绝对路径)]"""
    global PROG_LIST_CACHE
    if PROG_LIST_CACHE and not refresh:
        return PROG_LIST_CACHE
    dirs = [d for d in os.environ.get("PATH", "").split(os.pathsep) if d]
    prefix = os.environ.get("PREFIX")
    if prefix:
        pb = os.path.join(prefix, "bin")
        if pb not in dirs:
            dirs.insert(0, pb)
    for extra in ("/data/data/com.termux/files/usr/bin",
                  "/usr/local/bin", "/usr/bin", "/bin"):
        if extra not in dirs and os.path.isdir(extra):
            dirs.append(extra)
    seen, out = set(), []
    for d in dirs:
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for nm in names:
            if nm in seen or nm.startswith("."):
                continue
            full = os.path.join(d, nm)
            try:
                if os.path.isfile(full) and os.access(full, os.X_OK):
                    seen.add(nm)
                    out.append((nm, full))
            except OSError:
                continue
    out.sort(key=lambda t: t[0].lower())
    PROG_LIST_CACHE = out
    return out


def open_with_choices(paths):
    """按文件类型 + Termux 实际装了哪些程序，生成「打开方式」候选列表"""
    path = paths[0] if paths else ""
    base = os.path.basename(path.rstrip("/")) or path
    is_dir = os.path.isdir(path)
    _, ext = os.path.splitext(base)
    low_name = base.lower()
    choices = []
    # 第一条永远是"系统默认"
    if shutil.which("termux-open"):
        choices.append(("系统默认（termux-open）", ["termux-open", path], False))
    elif shutil.which("xdg-open"):
        choices.append(("系统默认（xdg-open）", ["xdg-open", path], False))
    if is_dir:
        choices.append(("看目录内容（ls -l）", ["ls", "-l", "--color=always", path], True))
        return choices, ext
    for label, need, argv, exts in OPEN_WITH_CANDIDATES:
        if exts is not None:
            if not any(low_name.endswith(e) for e in exts):
                continue
        if not shutil.which(need):
            continue
        detach = need in ("termux-open", "xdg-open", "am")
        choices.append((label, list(argv) + [path], not detach))
    if not choices:
        choices.append(("（没有可用的程序，先 pkg install nano）", None, False))
    choices.append(("其他…（搜索本机程序）", None, "browse"))
    return choices, ext


