    def scan_dir(path):
        """返回 (entries, err)。目录不可用/已镂空时 err 非空，绝不抛异常。"""
        entries = []
        parent_path = os.path.dirname(path.rstrip("/")) or "/"
        entries.append({"path": parent_path, "name": ".. (GO UP)",
                        "is_dir": True, "is_parent_link": True})
        try:
            names = os.listdir(path)
        except FileNotFoundError:
            return None, "路径不存在（可能已被删除或移动）"
        except NotADirectoryError:
            return None, "目标不是文件夹"
        except PermissionError:
            return None, "无权限访问该目录"
        except OSError as e:
            return None, f"无法访问（{getattr(e, 'strerror', None) or e}）"

        for name in sorted(names, key=lambda s: s.lower()):
            if not PREFS.get("show_hidden", False) and name.startswith("."):
                continue
            fullp = os.path.join(path, name)
            try:
                is_dir = os.path.isdir(fullp)
                st = os.lstat(fullp)   # 幽灵条目检测 + 取大小/时间
            except OSError:
                continue
            entries.append({"path": fullp, "name": name, "is_dir": is_dir,
                            "is_parent_link": False,
                            "size": st.st_size, "mtime": st.st_mtime,
                            "mode": st.st_mode})
        parent = entries[0]
        return sort_entries(entries, parent), ""

    def rescan_directory():
        nonlocal original_scan_entries, scan_entries, cursor_idx, view_offset
        nonlocal current_pwd, status_msg, dirty

        # ① 当前目录镂空检测：逐级向上找最近可用目录
        fallback_from = None
        p = current_pwd
        guard = 0
        while not os.path.isdir(p) and guard < 256:
            if fallback_from is None:
                fallback_from = p
            parent = os.path.dirname(p.rstrip("/")) or "/"
            if parent == p:
                break
            p = parent
            guard += 1

        if not os.path.isdir(p):
            current_pwd = "/"
            original_scan_entries.clear()
            original_scan_entries.append({"path": "/", "name": ".. (GO UP)",
                                          "is_dir": True, "is_parent_link": True})
            scan_entries = original_scan_entries.copy()
            cursor_idx = 0
            view_offset = 0
            selected_set.clear()
            set_status(f"路径不存在: {fallback_from or current_pwd}")
            remember_dir()
            return

        rollback_note = ""
        if p != current_pwd:
            rollback_note = f"原路径已不存在: {fallback_from}"
            current_pwd = p

        # ② 扫描目录
        entries, err = scan_dir(current_pwd)
        if entries is None:
            parent = os.path.dirname(current_pwd.rstrip("/")) or "/"
            if parent != current_pwd and os.path.isdir(parent):
                current_pwd = parent
                entries, err = scan_dir(current_pwd)
                if entries is not None:
                    rollback_note = (rollback_note + "；" if rollback_note else "") + \
                                    f"{err} → 已回退到 {current_pwd}"
            if entries is None:
                current_pwd = "/"
                original_scan_entries.clear()
                original_scan_entries.append({"path": "/", "name": ".. (GO UP)",
                                              "is_dir": True, "is_parent_link": True})
                scan_entries = original_scan_entries.copy()
                cursor_idx = 0
                view_offset = 0
                selected_set.clear()
                set_status(f"{err}；已回到根目录")
                remember_dir()
                return

        original_scan_entries.clear()
        original_scan_entries.extend(entries)
        scan_entries = original_scan_entries.copy()
        cursor_idx = 0
        view_offset = 0
        selected_set.clear()
        if rollback_note:
            set_status(rollback_note)
        else:
            status_msg = ""
        dirty = True
        remember_dir()

    def safe_enter_dir(target):
        """进入目录前先做镂空检测，失败只提示不崩溃"""
        nonlocal current_pwd, old_pwd, status_msg, dirty
        if not target:
            set_status("路径为空，无法进入")
            return False
        if not os.path.exists(target):
            set_status(f"文件夹不存在或已被删除: {target}")
            return False
        if not os.path.isdir(target):
            set_status(f"目标不是文件夹: {target}")
            return False
        try:
            os.listdir(target)
        except PermissionError:
            set_status(f"无权限访问: {target}")
            return False
        except OSError as e:
            set_status(f"无法访问: {target}（{getattr(e, 'strerror', None) or e}）")
            return False
        old_pwd = current_pwd
        current_pwd = target
        status_msg = ""
        rescan_directory()
        return True

