    def adv_open_run(vals):
        """按弹窗里的程序 + 参数去开选中的目标；{} 逐个替换成目标路径"""
        nonlocal mode, dirty
        prog_s = vals.get("prog", "").strip()
        if not prog_s:
            TD["note"] = "程序不能空（TAB 可浏览）"
            return
        try:
            head = shlex.split(prog_s)
        except ValueError as e:
            TD["note"] = f"程序那行解析失败: {e}"
            return
        if not head:
            TD["note"] = "程序那行是空的"
            return
        binp = head[0]
        if os.path.sep in binp:
            if not os.path.exists(binp):
                TD["note"] = f"程序不存在: {binp}"
                return
        elif not shutil.which(binp):
            TD["note"] = f"PATH 里找不到 {binp}"
            return
        try:
            args = shlex.split(vals.get("argstr", "").strip())
        except ValueError as e:
            TD["note"] = f"参数解析失败: {e}"
            return
        wd = vals.get("cwd", "").strip() or current_pwd
        if not os.path.isdir(wd):
            TD["note"] = f"工作目录不存在: {wd}"
            return
        wait = vals.get("wait", "y").strip().lower() not in (
            "n", "no", "0", "否", "不", "false")
        tgts = ow_targets or ([ow_path] if ow_path else [])
        if not tgts:
            TD["note"] = "先回到列表选中要打开的文件/目录"
            return
        if any("{}" in a for a in args):
            mode = MODE_LIST
            dirty = True
            for t in tgts:
                one = [a.replace("{}", t) for a in (head[1:] + args)]
                launch_program([binp] + one, wait, cwd=wd, tgts=[t],
                               append_targets=False)
        else:
            mode = MODE_LIST
            dirty = True
            launch_program([binp] + head[1:] + args, wait, cwd=wd, tgts=tgts)

