    def target_entries():
        """选中项优先；未选中则取光标项 -> (entries, err)"""
        ents = []
        if selected_set:
            for i in sorted(selected_set):
                if 0 <= i < len(original_scan_entries):
                    e = original_scan_entries[i]
                    if not e.get("is_parent_link"):
                        ents.append(e)
        elif scan_entries:
            e = scan_entries[min(cursor_idx, len(scan_entries) - 1)]
            if e.get("is_parent_link"):
                return [], "光标停在 “..” 上：先勾选项目或进入子目录"
            ents.append(e)
        if not ents:
            return [], "没有可操作的项（先勾选文件或目录）"
        return ents, ""

    def clipboard_mark(kind):
        nonlocal clip_mode, clip_items, dirty
        ents, err = target_entries()
        if err:
            set_status(err)
            return
        clip_mode = kind
        clip_items = [e["path"] for e in ents]
        names = ", ".join(os.path.basename(p.rstrip("/")) for p in clip_items[:3])
        if len(clip_items) > 3:
            names += f" …(+{len(clip_items) - 3})"
        set_status(f"📋 已{'复制' if kind == 'copy' else '剪切'} {len(clip_items)} 项: {names}"
                   f"  → Ctrl+V 粘到当前目录")
        dirty = True

    def clipboard_paste():
        nonlocal clip_mode, clip_items, dirty
        if not clip_items:
            set_status("剪贴板为空：先用 Ctrl+C 复制或 Ctrl+X 剪切")
            dirty = True
            return
        mode_now = clip_mode or "copy"
        ok, errs, skipped = 0, [], 0
        for src in list(clip_items):
            if not os.path.lexists(src):
                errs.append(f"{os.path.basename(src)}: 源已不存在")
                continue
            sdir = os.path.dirname(src.rstrip("/"))
            if mode_now == "cut" and sdir == current_pwd.rstrip("/"):
                skipped += 1
                continue
            if os.path.isdir(src) and not os.path.islink(src):
                base = src.rstrip("/") + "/"
                if (current_pwd.rstrip("/") + "/").startswith(base):
                    errs.append(f"{os.path.basename(src)}: 不能粘到它自身或子目录里")
                    continue
            if mode_now == "cut":
                tgt, e = move_path(src, current_pwd)
                
            else:
                tgt, e = copy_path(src, current_pwd)
            if e:
                errs.append(e)
            else:
                ok += 1
                if mode_now == "cut":
                    try:
                        clip_items.remove(src)
                    except ValueError:
                        pass
        if mode_now == "cut" and not clip_items:
            clip_mode = ""
        rescan_directory()
        verb = "移动" if mode_now == "cut" else "复制"
        msg = f"已{verb} {ok} 项 → {current_pwd}"
        if skipped:
            msg += f"，跳过 {skipped} 项（源与目标同一目录）"
        if errs:
            msg += "；失败: " + "；".join(errs[:2]) + (f" 等 {len(errs)} 项" if len(errs) > 2 else "")
        set_status(msg)
        dirty = True

    def nav_jump(step):
        """ALT+← / ALT+→：按目录历史前进后退"""
        nonlocal current_pwd, old_pwd, nav_idx, nav_moving, nav_seen, nav_hist, dirty
        if not nav_hist:
            return
        new = nav_idx + step
        while 0 <= new < len(nav_hist) and not os.path.isdir(nav_hist[new]):
            set_status(f"历史里的目录已不存在，跳过: {nav_hist[new]}")
            nav_hist.pop(new)
            if step < 0 and nav_idx > new:
                nav_idx -= 1
            if not (0 <= new < len(nav_hist)):
                return
        if not (0 <= new < len(nav_hist)):
            set_status("已经是第一个目录了" if step < 0 else "已经是最后一个目录了")
            dirty = True
            return
        nav_moving = True
        nav_idx = new
        old_pwd = current_pwd
        current_pwd = nav_hist[new]
        rescan_directory()
        nav_moving = False
        nav_seen = current_pwd
        set_status(f"{'← 返回' if step < 0 else '→ 前进'}: {current_pwd}  "
                   f"[{nav_idx + 1}/{len(nav_hist)}]")
        dirty = True

