def parse_config_value(key, kind, raw):
    """校验并转换输入的文本 -> (ok, value 或 error message)

    · int  : 必须是 1-9 的整数
    · bool : true/false/1/0/yes/no/on/off/system/python 等
    · enum : 必须落在 START_MODES 里
    · path : 展开 ~ 后转绝对路径；default_dir 要求目录存在
    """
    raw = (raw or "").strip()
    if kind == "int":
        try:
            n = int(raw)
        except ValueError:
            return False, f"{key} 需要整数 1-9"
        if not 1 <= n <= 9:
            return False, f"{key} 必须在 1-9 之间"
        return True, n
    if kind == "bool":
        low = raw.lower()
        if low in _CFG_BOOL_TRUE:
            return True, True
        if low in _CFG_BOOL_FALSE:
            return True, False
        return False, f"{key} 需要 true/false（也接受 1/0、system/python）"
    if kind == "enum":
        low = raw.lower()
        if low in START_MODES:
            return True, low
        return False, f"{key} 只能是 " + " / ".join(START_MODES)
    # path
    if not raw:
        if key == "last_dir":
            return True, ""          # 允许清空（等于“未记录”）
        return False, f"{key} 不能为空"
    pth = os.path.abspath(os.path.expanduser(raw))
    if key == "default_dir" and not os.path.isdir(pth):
        return False, f"默认目录不存在或不是文件夹: {pth}"
    return True, pth


