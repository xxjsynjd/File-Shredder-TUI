def collect_all_files(target_path):
    """收集目标下全部文件；路径镂空（已不存在）时返回空列表而不是崩溃"""
    out = []
    if not target_path:
        return out
    try:
        p = Path(target_path)
        if not os.path.exists(target_path):
            return out
        if p.is_file():
            return [str(p)]
        if p.is_dir():
            for root, _, files in os.walk(p, onerror=lambda e: None):
                for fn in files:
                    fp = os.path.join(root, fn)
                    try:
                        if os.path.isfile(fp):
                            out.append(fp)
                    except OSError:
                        continue
    except OSError:
        pass
    return out


_unit_map = {"K": 1024, "M": 1024 * 1024, "G": 1024 ** 3}


def _parse_size_token(s):
    s = s.strip()
    if not s:
        return None
    m = PAT_SIZE_OLD.match(s)
    if not m:
        return None
    num, unit = m.groups()
    return abs(int(num)) * _unit_map[unit]


def parse_size_interval_spec(spec):
    m = PAT_SIZE_INTERVAL.match(spec.strip())
    if not m:
        return None
    a, b = m.groups()
    return (_parse_size_token(a) if a.strip() else None,
            _parse_size_token(b) if b.strip() else None)


def parse_mdate_spec(spec):
    m = PAT_MDATE.match(spec.strip())
    if not m:
        return None
    op, datestr = m.groups()
    op = op or "="
    try:
        return (op, datetime.strptime(datestr, "%Y-%m-%d").timestamp())
    except ValueError:
        return None


def parse_mtime_spec(spec):
    m = PAT_MTIME_OLD.match(spec.strip())
    if not m:
        return None
    raw = spec.strip()
    num = int(m.group(1))
    op = ">" if raw.startswith("+") else ("<" if raw.startswith("-") else "=")
    return (op, num)


def text_width(text):
    """字符串显示宽度（中日韩全角算 2 列）"""
    return sum(2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1 for ch in str(text))


def input_cursor(buf, cur):
    """规范化光标位置"""
    return max(0, min(cur, len(buf)))


def edit_buffer(buf, cur, key):
    """行编辑内核：返回 (buf, cur, handled)。
    handled=False 表示这个键不是编辑键，交给调用方（ENTER/UP/DOWN/ESC 等）。"""
    if key == "LEFT":
        return buf, max(0, cur - 1), True
    if key == "RIGHT":
        return buf, min(len(buf), cur + 1), True
    if key == "HOME":
        return buf, 0, True
    if key == "END":
        return buf, len(buf), True
    if key == "BACKSPACE":
        if cur <= 0:
            return buf, 0, True
        return buf[:cur - 1] + buf[cur:], cur - 1, True
    if key == "DELETE":
        return buf[:cur] + buf[cur + 1:], cur, True
    if key == "INS":
        return buf, cur, True
    if isinstance(key, str) and len(key) == 1 and ord(key) >= 32:
        return buf[:cur] + key + buf[cur:], cur + 1, True
    return buf, cur, False


def clip(text, maxcols):
    """按显示宽度裁剪，中文占 2 列，避免 addstr 越界报 ERR"""
    if maxcols <= 0:
        return ""
    out, cols = [], 0
    for ch in str(text):
        wch = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if cols + wch > maxcols:
            break
        out.append(ch)
        cols += wch
    return "".join(out)


# ============ Shredder shell history（家目录持久化 + 内存）============
HISTORY_FILE = os.path.join(os.path.expanduser("~"), ".fileshredder_history")
HISTORY_MAX = 200


def load_history():
    """读取家目录历史文件；不存在/无权限/是目录时返回空列表，绝不抛异常"""
    try:
        with open(HISTORY_FILE, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.read().splitlines()
    except (FileNotFoundError, IsADirectoryError):
        return []
    except OSError:
        return []
    out = []
    for raw in lines:
        cmd = raw.strip()
        if cmd and (not out or out[-1] != cmd):
            out.append(cmd)
    return out[-HISTORY_MAX:]


def save_history(entries):
    """原子写入家目录历史文件（先写 .tmp 再 replace），失败只返回 False"""
    try:
        tmp = HISTORY_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            for e in entries[-HISTORY_MAX:]:
                f.write(e.replace("\r", " ").replace("\n", " ") + "\n")
        os.replace(tmp, HISTORY_FILE)
        try:
            os.chmod(HISTORY_FILE, 0o600)
        except OSError:
            pass
        return True
    except OSError:
        return False


def append_history(entries, cmd):
    """追加一条命令：空命令跳过、连续重复跳过、超上限裁剪，并立即落盘"""
    cmd = (cmd or "").strip()
    if not cmd:
        return entries
    if entries and entries[-1] == cmd:
        return entries
    entries.append(cmd)
    if len(entries) > HISTORY_MAX:
        del entries[:-HISTORY_MAX]
    save_history(entries)
    return entries


