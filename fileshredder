                    if rb["x1"] >= w:
                        break
                    put(btn_row, rb["x1"], rb["name"], curses.A_BOLD | curses.A_REVERSE,
                        maxcols=w - rb["x1"] - 1)

            elif mode == MODE_PREVIEW:
                put(0, 0, "📋 Preview selected items (Folders will RECURSIVELY shred)", curses.A_BOLD)
                put(1, 0, "=" * (w - 1))
                y = 2
                missing_n = 0
                for idx, ent in enumerate(all_selected_entries):
                    if ent.get("is_parent_link"):
                        continue
                    typ = "FOLDER(RECURSIVE)" if ent["is_dir"] else "FILE"
                    try:
                        exists = os.path.exists(ent["path"])
                    except OSError:
                        exists = False
                    if not exists:
                        missing_n += 1
                    tag = "" if exists else "  [已不存在,将跳过]"
                    if y >= btn_row - 1:
                        break
                    put(y, 0, f"[{idx + 1}] {typ}: {ent['path']}{tag}")
                    y += 1
                foot = "ENTER → Confirm | ESC Back"
                if missing_n:
                    foot = f"⚠ {missing_n} 项已不存在将被跳过 | " + foot
                put(btn_row - 1, 0, foot)
                put(btn_row, 0, "[Quit]  [Back]", curses.A_BOLD | curses.A_REVERSE)

            elif mode == MODE_CONFIRM1:
                msg = "⚠️ FIRST CONFIRM: You are going to shred selected items!"
                warn = "Folders will recursively overwrite ALL inner files!"
                prompt = "Press ENTER to continue to SECOND confirmation, ESC cancel"
                put(h // 2 - 2, max(0, w // 2 - len(msg) // 2), msg, curses.A_BOLD | curses.A_REVERSE)
                put(h // 2 - 1, max(0, w // 2 - len(warn) // 2), warn)
                put(h // 2, max(0, w // 2 - len(prompt) // 2), prompt)
                put(btn_row, 0, "[Quit]  [Cancel]  [NextConfirm]", curses.A_BOLD | curses.A_REVERSE)

            elif mode == MODE_CONFIRM2:
                msg = "🚨 FINAL CONFIRM: DATA CANNOT BE RESTORED AFTER SHREDDING!"
                prompt = ">> ENTER START SHREDDING | ESC ABORT <<"
                put(h // 2 - 1, max(0, w // 2 - len(msg) // 2), msg, curses.A_BOLD | curses.A_REVERSE)
                put(h // 2, max(0, w // 2 - len(prompt) // 2), prompt)
                put(btn_row, 0, "[Quit]  [Abort]  [START SHRED]", curses.A_BOLD | curses.A_REVERSE)

            elif mode == MODE_SHREDDING:
                split_x = max(10, w // 2)
                put(0, 0, "📌 Processing Path", curses.A_BOLD)
                put(1, 0, "-" * (split_x - 1))
                left_h = btn_row - 3
                if current_global_idx < len(total_file_list):
                    cp = total_file_list[current_global_idx]
                    put(2, 0, f">>> {cp}", curses.A_REVERSE, maxcols=split_x - 1)
                    hy = 3
                    for hi in range(max(0, current_global_idx - (left_h - 3)), current_global_idx):
                        if hy >= left_h + 2:
                            break
                        put(hy, 0, f"✓ {total_file_list[hi]}", maxcols=split_x - 1)
                        hy += 1
                put(0, split_x, "✅ Shred Status", curses.A_BOLD)
                put(1, split_x, "-" * max(0, w - split_x - 1))
                gd, gt = current_global_idx, total_file_count
                gp = int(gd / gt * 100) if gt else 0
                put(2, split_x, f"Total: {gd}/{gt}  {gp}%")
                bw = max(1, w - split_x - 4)
                bf = int(bw * gp / 100)
                put(3, split_x, f"[{'#' * bf}{'-' * (bw - bf)}]")
                put(5, split_x, f"Current File: {current_file_pct}%")
                put(6, split_x, f"Status: {current_file_status}")

            elif mode == MODE_CMDLINE:
                hint = f"↑↓ 历史({len(hist_list)})"
                if hist_list and cmd_hist_idx < len(hist_list):
                    hint += f" [{cmd_hist_idx + 1}/{len(hist_list)}]"
                put(0, 0, f"📂 Command mode | ESC cancel | {hint} | cmd: {cmd_buffer}", curses.A_BOLD)
                if cmd_error:
                    put(1, 0, f"⚠️ {cmd_error}", curses.A_REVERSE)

                # 历史浏览：显示当前光标附近若干条，当前项高亮
                y = 3 if cmd_error else 2
                max_lines = btn_row - y - 1
                if hist_list and max_lines > 0:
                    start = max(0, cmd_hist_idx - 3)
                    end = min(len(hist_list), start + max_lines)
                    if end - start < max_lines:
                        start = max(0, end - max_lines)
                    for hi in range(start, end):
                        if y >= btn_row - 1:
                            break
                        prefix = ">" if hi == cmd_hist_idx else " "
                        attr = curses.A_REVERSE if hi == cmd_hist_idx else curses.A_NORMAL
                        put(y, 0, f"{prefix} {hi + 1}: {hist_list[hi]}", attr)
                        y += 1

                put(btn_row, 0, f":{cmd_buffer}", curses.A_REVERSE)
                put(btn_row - 1, 0, f"history file: {HISTORY_FILE}")

            stdscr.refresh()
            dirty = False

        # ---- shred 生成器推进（无按键也继续跑）----
        if mode == MODE_SHREDDING:
            if current_global_idx >= total_file_count:
                stdscr.erase()
                put(0, 0, "🎉 All shred tasks finished!", curses.A_BOLD)
                put(2, 0, f"Total shredded files: {total_file_count}")
                put(4, 0, "Press any key back to directory browser")
                stdscr.refresh()
                while key_reader.read_one() is None:
                    time.sleep(0.03)
                search_mode = False
                search_keyword = ""
                search_matches = []
                mode = MODE_LIST
                rescan_directory()
                continue
            if current_file_generator is None:
                current_file_generator = shred_single_file(
                    total_file_list[current_global_idx], passes=SHRED_PASSES)
            try:
                current_file_pct, current_file_status = next(current_file_generator)
                dirty = True
            except StopIteration:
                current_global_idx += 1
                current_file_generator = None
                current_file_pct = 0
                current_file_status = "Waiting next file"
                dirty = True

        key = key_reader.read_one()
        if key is None:
            time.sleep(0.03)
            continue

        # ---- 鼠标 / 触屏 ----
        if isinstance(key, tuple) and key[0] == "MOUSE":
            _, btn, mx, my, pressed = key
            mx -= 1
            my -= 1

            if btn == 64:
                cursor_idx = max(0, cursor_idx - 1)
                _scroll_to(cursor_idx)
                continue
            if btn == 65:
                cursor_idx = min(len(scan_entries) - 1, cursor_idx + 1)
                _scroll_to(cursor_idx)
                continue

            if mode == MODE_LIST:
                h, w = stdscr.getmaxyx()
                btn_row = h - 1
                rendered_buttons = []
                bx = 0
                gap = 2
                for (bname, action) in btn_defs:
                    b_len = len(bname)
                    rendered_buttons.append({"name": bname, "action": action,
                                             "x1": bx, "x2": bx + b_len - 1})
                    bx += b_len + gap

                if my == btn_row:
                    for rb in rendered_buttons:
                        if rb["x1"] <= mx <= rb["x2"]:
                            action = rb["action"]
                            if action == "quit":
                                return
                            elif action == "sel_all":
                                selected_set.clear()
                                for i, e in enumerate(original_scan_entries):
                                    if not e.get("is_parent_link"):
                                        selected_set.add(i)
                                set_status(f"已全选 {len(selected_set)} 项")
                            elif action == "clear_sel":
                                selected_set.clear()
                                set_status("已清空选择")
                            elif action == "confirm":
                                if not selected_set:
                                    set_status("未选中任何项，无法进入预览")
                                else:
                                    all_selected_entries = [
                                        original_scan_entries[i] for i in sorted(selected_set)
                                        if not original_scan_entries[i].get("is_parent_link")]
                                    mode = MODE_PREVIEW
                                    dirty = True
                            break
                elif not search_mode:
                    dl = my - 2
                    max_lines = btn_row - 4
                    if max_lines < 1:
                        max_lines = 1
                    if 0 <= dl < max_lines:
                        ci = view_offset + dl
                        if 0 <= ci < len(scan_entries):
                            cursor_idx = ci
                            if ci in selected_set:
                                selected_set.discard(ci)
                            else:
                                selected_set.add(ci)
                            dirty = True
            continue

        # ---- 列表页键盘 ----
        if mode == MODE_LIST:
            if search_mode:
                search_matches = compute_search_matches(search_keyword)
                dirty = True
                if key == "ESC":
                    search_mode = False
                elif key == "ENTER":
                    search_mode = False
                    if search_matches:
                        current_match_idx = 0
                        goto_next_match()
                elif key == "BACKSPACE":
                    search_keyword = search_keyword[:-1]
                else:
                    search_keyword += key
                continue

            if key == '/':
                search_mode = True
                dirty = True
            elif key == "UP":
                cursor_idx = max(0, cursor_idx - 1)
                _scroll_to(cursor_idx)
            elif key == "DOWN":
                cursor_idx = min(len(scan_entries) - 1, cursor_idx + 1)
                _scroll_to(cursor_idx)
            elif key == ' ':
                if scan_entries:
                    if cursor_idx in selected_set:
                        selected_set.discard(cursor_idx)
                    else:
                        selected_set.add(cursor_idx)
                    dirty = True
            elif key == "ENTER":
                if not scan_entries:
                    continue
                ce = scan_entries[cursor_idx]
                if ce.get("is_parent_link") or ce["is_dir"]:
                    # 镂空检测后再进入
                    safe_enter_dir(ce["path"])
                else:
                    p = ce["path"]
                    if not os.path.isfile(p):
                        set_status(f"文件不存在或已被删除: {p}")
                        continue
                    if not selected_set:
                        selected_set.add(cursor_idx)
                    all_selected_entries = [
                        original_scan_entries[i] for i in sorted(selected_set)
                        if not original_scan_entries[i].get("is_parent_link", False)]
                    if not all_selected_entries:
                        set_status("没有可处理的选中项")
                        continue
                    mode = MODE_PREVIEW
                    dirty = True
            elif key == 'q':
                return
            elif key == ':':
                mode = MODE_CMDLINE
                cmd_buffer = ""
                cmd_error = ""
                cmd_hist_idx = len(hist_list)
                cmd_draft = ""
                dirty = True
            elif key == 'n':
                goto_next_match()
            elif key == 'N':
                goto_prev_match()

        # ---- 命令行（含 shell history ↑↓ 调取：内存 + 家目录文件合并）----
        elif mode == MODE_CMDLINE:
            if key == "ESC":
                mode = MODE_LIST
                cmd_buffer = ""
                cmd_error = ""
                cmd_hist_idx = len(hist_list)
                cmd_draft = ""
                dirty = True
            elif key == "UP":
                # 上翻历史：第一次离开当前输入时先暂存草稿
                if hist_list:
                    if cmd_hist_idx >= len(hist_list):
                        cmd_draft = cmd_buffer
                    if cmd_hist_idx > 0:
                        cmd_hist_idx -= 1
                        cmd_buffer = hist_list[cmd_hist_idx]
                    dirty = True
            elif key == "DOWN":
                # 下翻历史：越过末尾回到草稿
                if hist_list:
                    if cmd_hist_idx < len(hist_list) - 1:
                        cmd_hist_idx += 1
                        cmd_buffer = hist_list[cmd_hist_idx]
                    elif cmd_hist_idx >= len(hist_list) - 1:
                        cmd_hist_idx = len(hist_list)
                        cmd_buffer = cmd_draft
                    dirty = True
            elif key == "ENTER":
                raw_cmd = cmd_buffer.strip()
                parts = raw_cmd.split(maxsplit=1)
                cmd_error = ""
                if not parts:
                    mode = MODE_LIST
                    dirty = True
                    continue
                cmd = parts[0]
                rest = parts[1] if len(parts) >= 2 else ""
                if cmd == "cd":
                    arg = rest.strip()
                    if not arg:
                        cmd_error = "cd 需要路径参数，例如 :cd /sdcard"
                    elif arg == "-":
                        if os.path.isdir(old_pwd):
                            tmp = current_pwd
                            current_pwd = old_pwd
                            old_pwd = tmp
                            status_msg = ""
                            rescan_directory()
                        else:
                            cmd_error = f"上一路径已不存在: {old_pwd}"
                    else:
                        target = os.path.abspath(os.path.join(current_pwd, arg))
                        if not os.path.exists(target):
                            cmd_error = f"路径不存在: {target}"
                        elif not os.path.isdir(target):
                            cmd_error = f"目标不是文件夹: {target}"
                        else:
                            try:
                                os.listdir(target)
                            except PermissionError:
                                cmd_error = f"无权限访问: {target}"
                            except OSError as e:
                                cmd_error = f"无法访问: {target}（{getattr(e, 'strerror', None) or e}）"
                            else:
                                old_pwd = current_pwd
                                current_pwd = target
                                status_msg = ""
                                rescan_directory()
                elif cmd == "select":
                    arg = rest.strip()
                    if arg == "":
                        if scan_entries and 0 <= cursor_idx < len(scan_entries):
                            ent = scan_entries[cursor_idx]
                            if not ent.get("is_parent_link"):
                                if cursor_idx in selected_set:
                                    selected_set.discard(cursor_idx)
                                else:
                                    selected_set.add(cursor_idx)
                                dirty = True
                    elif arg == "!":
                        select_invert()
                    elif arg == "clear":
                        selected_set.clear()
                        dirty = True
                        set_status("已清空选择")
                    else:
                        hit, msg = select_multi_condition(arg)
                        cmd_error = "" if hit > 0 else "没有条目符合条件"
                        set_status(msg if hit > 0 else "0 项匹配")
                elif cmd == "history":
                    if not hist_list:
                        set_status(f"历史为空（文件 {HISTORY_FILE}）")
                    else:
                        set_status(f"历史 {len(hist_list)} 条 → 文件 {HISTORY_FILE}")
                elif cmd == "history-clear":
                    hist_list = []
                    save_history(hist_list)
                    set_status(f"历史已清空（{HISTORY_FILE}）")
                else:
                    cmd_error = f"unknown cmd: {cmd}，支持 cd / select / history"

                # 成功失败都记入历史（方便直接 ↑ 重试）
                hist_list = append_history(hist_list, raw_cmd)
                cmd_hist_idx = len(hist_list)
                cmd_draft = ""
                if not cmd_error:
                    mode = MODE_LIST
                dirty = True
            elif key == "BACKSPACE":
                if cmd_hist_idx < len(hist_list):
                    # 从历史项继续编辑 → 视为新命令，不污染原条目
                    cmd_hist_idx = len(hist_list)
                    cmd_draft = cmd_buffer
                cmd_buffer = cmd_buffer[:-1]
                dirty = True
            else:
                if isinstance(key, str) and len(key) > 1:
                    # LEFT / RIGHT 等多字符序列忽略，避免拼进命令
                    pass
                else:
                    if cmd_hist_idx < len(hist_list):
                        cmd_hist_idx = len(hist_list)
                        cmd_draft = cmd_buffer
                    cmd_buffer += key
                    dirty = True

        # ---- 预览 / 双重确认 ----
        elif mode == MODE_PREVIEW:
            if key == "ENTER":
                mode = MODE_CONFIRM1
                dirty = True
            elif key == "ESC":
                mode = MODE_LIST
                dirty = True

        elif mode == MODE_CONFIRM1:
            if key == "ENTER":
                mode = MODE_CONFIRM2
                dirty = True
            elif key == "ESC":
                mode = MODE_LIST
                dirty = True

        elif mode == MODE_CONFIRM2:
            if key == "ENTER":
                total_file_list.clear()
                missing = 0
                for ent in all_selected_entries:
                    if not os.path.exists(ent["path"]):
                        missing += 1
                        continue
                    total_file_list.extend(collect_all_files(ent["path"]))
                total_file_count = len(total_file_list)
                current_global_idx = 0
                current_file_generator = None
                current_file_pct = 0
                if total_file_count == 0:
                    mode = MODE_LIST
                    set_status(f"选中项已不存在或为空（缺失 {missing} 项），无文件可粉碎")
                else:
                    mode = MODE_SHREDDING
                    dirty = True
            elif key == "ESC":
                mode = MODE_LIST
                dirty = True


if __name__ == "__main__":
    USE_SYSTEM_SHRED = True
    if not os.path.exists("/storage/emulated/0"):
        print("[!] 先执行 termux-setup-storage 授权存储")
        sys.exit(1)
    print("===== 镂空检测版：路径不存在只提示，不崩溃 =====")
    print(f"[*] shell history 文件: {HISTORY_FILE}   (: 进入命令行后 ↑↓ 调取)")
    curses.wrapper(tui_main)
