def search_hist_all(hist, query):
    """返回所有包含 query 的历史下标，新的在前"""
    q = (query or "").lower()
    return [i for i in range(len(hist) - 1, -1, -1) if q in hist[i].lower()]


def rev_search_hist(hist, query, start):
    """在历史里从 start 往前找包含 query 的项，返回下标或 None"""
    q = (query or "").lower()
    i = min(start, len(hist) - 1)
    while i >= 0:
        if q in hist[i].lower():
            return i
        i -= 1
    return None


def complete_path(arg, base_cwd):
    """Tab 路径补全 -> (新参数字符串或 None, [(显示文本, 完整参数)], 提示)

    支持相对路径 / 绝对路径 / ~ 开头；唯一命中且是目录时自动补 / 结尾。
    多命中时通过第 2 项返回全部候选，供菜单选择。
    """
    raw = arg or ""
    dirpart, prefix = os.path.split(raw)
    if os.path.isabs(os.path.expanduser(raw)):
        searchdir = os.path.expanduser(dirpart) or "/"
    else:
        searchdir = os.path.abspath(os.path.join(base_cwd, os.path.expanduser(dirpart))) \
            if dirpart else base_cwd
    try:
        names = os.listdir(searchdir)
    except OSError as e:
        return None, [], f"无法列目录 {searchdir}（{getattr(e, 'strerror', None) or e}）"

    if not prefix:
        cands = [n for n in names if not n.startswith(".")]
    else:
        cands = [n for n in names if n.startswith(prefix)]
    cands.sort(key=lambda x: x.lower())
    if not cands:
        return None, [], f"无匹配: {raw}"

    base = dirpart + "/" if dirpart else ""
    items = []
    for n in cands:
        isdir = os.path.isdir(os.path.join(searchdir, n))
        tail = "/" if isdir else ""
        items.append((n + tail, base + n + tail))

    if len(items) == 1:
        return items[0][1], items, f"补全 → {items[0][1]}"
    common = os.path.commonprefix(cands)
    newarg = base + common if len(common) > len(prefix) else None
    return newarg, items, f"{len(items)} 项候选"


def compute_pick_geo(title, items, sel, h, w):
    """菜单框布局 -> (top, left, boxw, shown, off)；渲染与点击命中共用"""
    labels = [it[0] for it in items] or [""]
    boxw = max(max(text_width(l) for l in labels),
               text_width(title) + 9,      # 给 "  共N项" 留位置
               16) + 6
    boxw = max(min(boxw, w - 2), 20)
    shown = min(len(items), max(3, h - 9))
    top = max(2, (h - (shown + 5)) // 2)
    left = max(0, (w - boxw) // 2)
    off = 0
    if sel >= shown:
        off = sel - shown + 1
    if sel < off:
        off = sel
    return top, left, boxw, shown, off


