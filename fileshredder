    # ---------------- 标签页 ----------------
    def tab_title(i):
        d = tabs[i] if i < len(tabs) and tabs[i] else None
        if d and (d.get("name") or "").strip():
            return d["name"]
        path = (d["cwd"] if d else (current_pwd if i == tab_idx else "/"))
        return os.path.basename(path.rstrip("/")) or path

    def tab_color(i):
        d = tabs[i] if i < len(tabs) and tabs[i] else None
        try:
            c = int(d.get("color", 0)) if d else 0
        except (TypeError, ValueError):
            c = 0
        return c if 0 <= c < len(TAB_COLOR_NAMES) else 0

    def tab_attr(i, active):
        attr = curses.A_NORMAL
        c = tab_color(i)
        if c and curses.has_colors():
            try:
                attr |= curses.color_pair(TAB_COLOR_PAIRS[c])
            except curses.error:
                pass
        return attr | (curses.A_REVERSE | curses.A_BOLD if active else 0)

    def tab_snapshot():
        nonlocal tabs
        prev = tabs[tab_idx] if tab_idx < len(tabs) and tabs[tab_idx] else {}
        tabs[tab_idx] = {
            "name": prev.get("name", ""),
            "color": prev.get("color", 0),
            "cwd": current_pwd,
            "orig": list(original_scan_entries),
            "entries": list(scan_entries),
            "cursor": cursor_idx,
            "sel": set(selected_set),
            "view": view_offset,
            "search_mode": search_mode,
            "search_kw": search_keyword,
            "matches": list(search_matches),
            "match_idx": current_match_idx,
            "nav_hist": list(nav_hist),
            "nav_idx": nav_idx,
            "nav_seen": nav_seen,
        }

    def tab_load(d):
        nonlocal current_pwd, original_scan_entries, scan_entries, cursor_idx, selected_set
        nonlocal view_offset, search_mode, search_keyword, search_matches, current_match_idx
        nonlocal nav_hist, nav_idx, nav_seen, status_msg, dirty
        current_pwd = d["cwd"]
        original_scan_entries = list(d["orig"])
        scan_entries = list(d["entries"])
        cursor_idx = d["cursor"] if d["entries"] else 0
        selected_set = set(d["sel"])
        view_offset = d["view"]
        search_mode = d["search_mode"]
        search_keyword = d["search_kw"]
        search_matches = list(d["matches"])
        current_match_idx = d["match_idx"]
        nav_hist = list(d["nav_hist"])
        nav_idx = d["nav_idx"]
        nav_seen = d["nav_seen"]
        status_msg = ""
        dirty = True
        if not scan_entries:
            rescan_directory()

    def switch_tab(i):
        nonlocal tab_idx
        if not tabs or i < 0 or i >= len(tabs) or i == tab_idx:
            return
        tab_snapshot()
        tab_idx = i
        tab_load(tabs[i])

    def new_tab(path=None):
        nonlocal tabs, tab_idx, dirty
        if len(tabs) >= 9:
            set_status("最多 9 个标签页")
            return
        tab_snapshot()
        target = os.path.abspath(os.path.expanduser(path)) if path else current_pwd
        if not os.path.isdir(target):
            target = current_pwd
        tabs.append({
            "name": "", "color": 0,
            "cwd": target, "orig": [], "entries": [], "cursor": 0, "sel": set(),
            "view": 0, "search_mode": False, "search_kw": "", "matches": [],
            "match_idx": 0, "nav_hist": [target], "nav_idx": 0, "nav_seen": target,
        })
        tab_idx = len(tabs) - 1
        tab_load(tabs[tab_idx])
        rescan_directory()
        set_status(f"新建标签页 {tab_idx + 1}/{len(tabs)}: {target}")

    def close_tab():
        nonlocal tabs, tab_idx
        if len(tabs) <= 1:
            set_status("只剩一个标签页，无法关闭")
            return
        tabs.pop(tab_idx)
        if tab_idx >= len(tabs):
            tab_idx = len(tabs) - 1
        tab_load(tabs[tab_idx])
        set_status(f"已关闭，剩余 {len(tabs)} 个标签页")

    def open_tab_rename():
