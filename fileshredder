    def list_window(sel, total, rows, prev):
        """把光标滚动成"窗口跟着走"：返回新的首行下标，保证 sel 落在可见区里。

        之前打开方式/程序搜索列表直接把所有条目从固定行往下画，
        超出屏幕的行被 put() 静默丢弃 —— 光标一滚到底就"看不见了"。
        """
        rows = max(1, int(rows))
        total = max(0, int(total))
        if total <= rows:
            return 0
        off = min(max(0, int(prev)), total - rows)
        sel = min(max(0, int(sel)), total - 1)
        if sel < off:
            off = sel
        elif sel >= off + rows:
            off = sel - rows + 1
        return off

    def list_range_hint(off, count, total):
