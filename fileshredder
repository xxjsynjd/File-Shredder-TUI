def browse_entries(path, show_hidden=False):
    """文件管理器式目录列表：目录在前、文件在后 -> [(name, full, is_dir, is_exec)]"""
    dirs, files = [], []
    try:
        names = os.listdir(path)
    except OSError:
        return [], "目录读不了（权限不足或已不存在）"
    for nm in names:
        if not show_hidden and nm.startswith("."):
            continue
        full = os.path.join(path, nm)
        try:
            if os.path.isdir(full):
                dirs.append((nm, full, True, True))
            else:
                is_exec = os.path.isfile(full) and os.access(full, os.X_OK)
                files.append((nm, full, False, bool(is_exec)))
        except OSError:
            continue
    dirs.sort(key=lambda t: t[0].lower())
    files.sort(key=lambda t: t[0].lower())
    return dirs + files, ""


PROG_LIST_CACHE = []


def system_programs(refresh=False):
    """扫描 PATH（含 Termux 的 $PREFIX/bin）里的可执行文件 -> [(名字, 绝对路径)]"""
    global PROG_LIST_CACHE
    if PROG_LIST_CACHE and not refresh:
        return PROG_LIST_CACHE
    dirs = [d for d in os.environ.get("PATH", "").split(os.pathsep) if d]
    prefix = os.environ.get("PREFIX")
    if prefix:
        pb = os.path.join(prefix, "bin")
        if pb not in dirs:
            dirs.insert(0, pb)
    for extra in ("/data/data/com.termux/files/usr/bin",
                  "/usr/local/bin", "/usr/bin", "/bin"):
        if extra not in dirs and os.path.isdir(extra):
            dirs.append(extra)
    seen, out = set(), []
    for d in dirs:
        try:
            names = os.listdir(d)
        except OSError:
            continue
        for nm in names:
            if nm in seen or nm.startswith("."):
                continue
            full = os.path.join(d, nm)
            try:
                if os.path.isfile(full) and os.access(full, os.X_OK):
                    seen.add(nm)
                    out.append((nm, full))
            except OSError:
                continue
    out.sort(key=lambda t: t[0].lower())
    PROG_LIST_CACHE = out
    return out


