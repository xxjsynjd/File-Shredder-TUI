    def put(y, x, text, attr=0, maxcols=None):
        h, w = stdscr.getmaxyx()
        if y < 0 or y >= h or x < 0 or x >= w:
            return
        if maxcols is None:
            maxcols = w - x - 1
        try:
            stdscr.addstr(y, x, clip(text, max(maxcols, 0)), attr)
        except curses.error:
            pass

    def put_input(y, x, prefix, buf, cur, suffix="", attr=0):
        """渲染一行输入框，光标位置画反色块（在末尾时画反色空格）"""
        cur = input_cursor(buf, cur)
        head = prefix + buf[:cur]
        under = buf[cur:cur + 1] or " "
        tail = buf[cur + 1:] + suffix
        put(y, x, head, attr)
        cx = x + text_width(head)
        put(y, cx, under, attr | curses.A_REVERSE)
        if tail:
            put(y, cx + 1, tail, attr)

    def pick_geo(title, items, sel):
        h, w = stdscr.getmaxyx()
        return compute_pick_geo(title, items, sel, h, w)

    def render_pick(title, items, sel, hint="↑↓选择 · ENTER确认 · ESC取消"):
        """居中弹出菜单：标题 + 竖排候选，当前项反色"""
        top, left, boxw, shown, off = pick_geo(title, items, sel)
        inner_w = boxw - 2
        put(top, left, "┌" + "─" * inner_w + "┐", curses.A_BOLD)
        ttl = " " + clip(title, inner_w - 9) + f"  共{len(items)}项"
        put(top + 1, left, "│", curses.A_BOLD)
        put(top + 1, left + 1, clip(ttl, inner_w), curses.A_BOLD, maxcols=inner_w)
        put(top + 1, left + boxw - 1, "│", curses.A_BOLD)
        put(top + 2, left, "├" + "─" * inner_w + "┤", curses.A_BOLD)
        for i in range(shown):
            idx = off + i
            row = top + 3 + i
            put(row, left, "│", curses.A_BOLD)
            if idx < len(items):
                mark = "▶ " if idx == sel else "  "
                line = clip(mark + items[idx][0], inner_w)
                padn = inner_w - text_width(line)
                attr = curses.A_REVERSE if idx == sel else curses.A_NORMAL
                put(row, left + 1, line + " " * max(0, padn), attr, maxcols=inner_w)
            else:
                put(row, left + 1, " " * inner_w, 0, maxcols=inner_w)
            put(row, left + boxw - 1, "│", curses.A_BOLD)
        put(top + 3 + shown, left, "└" + "─" * inner_w + "┘", curses.A_BOLD)
        hnow, wnow = stdscr.getmaxyx()
        hint_row = min(top + 4 + shown, hnow - 2)
        put(hint_row, left, clip(hint, wnow - left - 1), curses.A_DIM)
        if off > 0:
            put(top + 3, left + boxw - 1, "▲", curses.A_BOLD)
        if off + shown < len(items):
            put(top + 3 + shown - 1, left + boxw - 1, "▼", curses.A_BOLD)

