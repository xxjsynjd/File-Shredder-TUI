    def sv_spawn(name, argv, url):
        try:
            p0 = subprocess.Popen(argv, stdin=subprocess.DEVNULL,
                                  stdout=subprocess.DEVNULL,
                                  stderr=subprocess.DEVNULL,
                                  start_new_session=True, cwd=current_pwd)
        except (OSError, ValueError) as e:
            return f"启动失败: {e}"
        SV["items"].append({"name": name, "pid": p0.pid, "url": url,
                            "argv": [str(x) for x in argv], "proc": p0})
        SV["sel"] = len(SV["items"]) - 1
        return ""

    def sv_kill(idx):
        if not (0 <= idx < len(SV["items"])):
            return "没有选中服务"
        it = SV["items"][idx]
        try:
            os.kill(it["pid"], signal.SIGTERM)
        except OSError as e:
            return f"停止失败: {e}"
        time.sleep(0.15)
        if it["proc"].poll() is None:
            try:
                os.kill(it["pid"], signal.SIGKILL)
            except OSError:
                pass
        SV["items"].pop(idx)
        return f"已停止 {it['name']}（PID {it['pid']}）"

