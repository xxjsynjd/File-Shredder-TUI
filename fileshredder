def parse_time_input(raw, cur_ts):
    """把输入解析成时间戳：now / +3（天） / 2026-11-27 / 2026-11-27 15:30:00"""
    s = (raw or "").strip()
    low = s.lower()
    if low in ("now", "今天", "现在"):
        return time.time()
    m = re.fullmatch(r"[+-]\d+", s)
    if m:
        return cur_ts + int(s) * 86400
    for fmt in ("%Y-%m-%d %H:%M:%S", "%Y-%m-%d %H:%M", "%Y-%m-%d"):
        try:
            return datetime.strptime(s, fmt).timestamp()
        except ValueError:
            continue
    return None


