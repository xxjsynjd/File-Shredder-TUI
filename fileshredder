        idx = max(0, min(len(progs) - 1, ow_prog_sel))
        path = progs[idx][1]
        set_status(f"正在用「{os.path.basename(path)}」打开…")
        dirty = True
        # 搜索出来的程序一律按"终端程序"处理（等它退出后回列表）
        launch_program([path], True)

