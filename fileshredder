def load_prefs():
    """读取偏好设置；文件缺失/损坏/类型不对时一律回落默认值，绝不抛异常"""
    data = dict(DEFAULT_PREFS)
    try:
        with open(PREFS_FILE, "r", encoding="utf-8") as f:
            raw = json.load(f)
    except (FileNotFoundError, IsADirectoryError, ValueError, OSError):
        return data
    if not isinstance(raw, dict):
        return data
    try:
        if isinstance(raw.get("passes"), int):
            data["passes"] = max(1, min(9, int(raw["passes"])))
    except (TypeError, ValueError):
        pass
    if isinstance(raw.get("use_system_shred"), bool):
        data["use_system_shred"] = raw["use_system_shred"]
    dd = raw.get("default_dir")
    if isinstance(dd, str) and dd.strip():
        data["default_dir"] = dd.strip()
    sm = raw.get("start_mode")
    if isinstance(sm, str) and sm.strip().lower() in START_MODES:
        data["start_mode"] = sm.strip().lower()
    ld = raw.get("last_dir")
    if isinstance(ld, str) and ld.strip():
        data["last_dir"] = ld.strip()
    for flag in ("show_hidden", "hide_ext", "dirs_first", "sort_reverse",
                 "show_size", "show_mtime", "show_perm", "show_type"):
        if isinstance(raw.get(flag), bool):
            data[flag] = raw[flag]
    sk = raw.get("sort_key")
    if isinstance(sk, str) and sk.lower() in SORT_KEYS:
        data["sort_key"] = sk.lower()
    return data


