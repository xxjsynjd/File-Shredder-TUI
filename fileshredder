        return parts[min(max(0, PM["sel"]), len(parts) - 1)]

    def part_dev_of(p0):
        dk = DK
        if not dk["disks"]:
            return ""
        nm = dk["disks"][min(dk["disk_idx"], len(dk["disks"]) - 1)][0]
        path = dk["disks"][min(dk["disk_idx"], len(dk["disks"]) - 1)][1]
        if os.path.isfile(path):
            return f"{path}p{p0['num']}"
        return path + f"p{p0['num']}" if nm.startswith(("mmcblk", "loop", "nbd",
                                                      "pmem")) else path + str(p0["num"])

    def _mkpart_cb(f):
        path, _sz = dk_cur_dev()
        if not shutil.which("parted"):
            raise ValueError("没装 parted：pkg install parted（Termux 的 root-repo），"
                             "或在 proot 里用 Debian 的 parted")
        try:
            a, b = float(f["start"]), float(f["end"])
        except ValueError:
            raise ValueError("起止都写数字，单位 MB")
        if b <= a or a < 0:
            raise ValueError("结束必须大于起始（单位 MB）")
        fs = f["fs"].strip().lower() or "不格式化"
        fsarg = {"不格式化": "ext2", "none": "ext2", "": "ext2"}.get(fs, fs)
        cmds = [["parted", "-s", path, "unit", "MB", "mkpart", "primary",
                 fsarg, f"{a:g}", f"{b:g}"]]
        return (f"创建分区（{a:g}-{b:g} MB）",
                cmds,
                "只写分区表，不格式化；建完记得 mkfs（例如 mkfs.ext4 "
                f"{path}pN）—— 格式化会覆盖该段数据", "")

    def part_dispatch(kind):
        nonlocal mode, dirty
        dk = DK
        path, _sz = dk_cur_dev()
        if kind == "refresh":
            err = pt_guard(path, destructive=False)
            if err:
                dk["pt_msg"] = err
                dirty = True
                return
            tool = pt_tool(("partprobe", "blockdev"))
            if not tool:
                dk["pt_msg"] = "没有 partprobe / blockdev：改完分区表可能要先重插卡才认"
                dirty = True
                return
            if os.path.basename(tool) == "partprobe":
                px_begin("刷新 MBR / 重读分区表", [[tool, path]],
                         "只是让内核重读分区表，不动数据")
            else:
                px_begin("刷新 MBR / 重读分区表", [[tool, "--rereadpt", path]],
                         "只是让内核重读分区表，不动数据")
            return
        err = pt_guard(path)
        if err:
            dk["pt_msg"] = err
            dirty = True
            return
        if kind == "create":
            part_form_open("创建分区 · 输入范围（单位 MB）",
                           [("start", "起始 MB", "0"), ("end", "结束 MB", "1024"),
                            ("fs", "文件系统标记(可空)", "")], _mkpart_cb)
        elif kind in ("delete", "rename", "resize"):
            p0 = part_cur_part()
            if not p0:
                dk["pt_msg"] = "没有选中分区（这个磁盘还没有分区）"
                dirty = True
                return
            n = p0["num"]
            if kind == "delete":
                if not shutil.which("parted"):
                    dk["pt_msg"] = "没装 parted：pkg install parted"
                    dirty = True
                    return
                px_begin(f"删除分区 #{n}",
                         [["parted", "-s", path, "rm", str(n)]],
                         "删掉分区表项=那一段数据失去归属，等于丢数据；先备份", "")
            elif kind == "rename":
                part_form_open(f"重命名卷 · 分区 #{n}",
                               [("name", "卷标（≤11 字符 / GPT 可长）",
                                 p0.get("tag", "") or "")], _rename_cb)
            else:
                mb = max(0, p0["lba1"]) * 512 / (1024 * 1024)
                part_form_open(f"设置分区大小 · 分区 #{n}",
                               [("end", "新结束位置 MB", f"{mb:.0f}")], _resize_cb)
        elif kind == "mbr":
            part_form_open("设置 MBR · 写主引导记录（前 440 字节）",
                           [("src", "来源(mbr.bin 路径 / zero)", "auto")], _mbr_cb)
        elif kind == "label":
            part_form_open("切换分区表类型",
                           [("lab", "目标类型(msdos / gpt)",
                             "gpt" if dk["pt_label"] == "msdos" else "msdos")],
                           _label_cb)

    def _rename_cb(f):
        p0 = part_cur_part()
        nm = f["name"].strip()
        if not nm:
            raise ValueError("卷标不能为空")
        path, _sz = dk_cur_dev()
        cmds = []
        if DK["pt_label"] == "gpt" and shutil.which("parted"):
            cmds.append(["parted", "-s", path, "name", str(p0["num"]), nm])
        dev = part_dev_of(p0)
        if shutil.which("e2label"):
            cmds.append(["e2label", dev, nm])
        if shutil.which("fatlabel"):
            cmds.append(["fatlabel", dev, nm])
        if not cmds:
            raise ValueError("没有 parted/e2label/fatlabel 可以改名")
        return (f"重命名卷 #{p0['num']} → {nm}", cmds,
                "只改卷标，不动数据（GPT 名字写在分区表里，ext/fat 卷标写文件系统里）",
                "soft")

    def _resize_cb(f):
        p0 = part_cur_part()
        try:
