from datetime import datetime
from pathlib import Path
import select

PAT_PASS = re.compile(r"pass\s+(\d+)/(\d+)")
PAT_SIZE_OLD = re.compile(r"([+-]?\d+)([KMG])")
PAT_MTIME_OLD = re.compile(r"([+-]?\d+)")
PAT_SIZE_INTERVAL = re.compile(r"\[(.*?),(.*?)\]")
PAT_MDATE = re.compile(r"([<>]?=?)(\d{4}-\d{2}-\d{2})")


def shred_single_file_python(file_path, passes=2, chunk_size=1024 * 1024):
    if not os.path.isfile(file_path):
        yield (0, "skip:not a file")
        return
    try:
        file_size = os.path.getsize(file_path)
        if file_size == 0:
            os.remove(file_path)
            yield (100, "OK:empty removed")
            return
        with open(file_path, "r+b") as f:
            for pass_no in range(passes):
                f.seek(0)
                written = 0
                while written < file_size:
                    to_write = min(chunk_size, file_size - written)
                    f.write(secrets.token_bytes(to_write))
                    written += to_write
                    yield (int(written / file_size * 100), f"Pass {pass_no + 1}/{passes} writing")
                f.flush()
                os.fsync(f.fileno())
        os.remove(file_path)
        yield (100, "✅ File shredded & deleted")
    except FileNotFoundError:
        yield (-1, "❌ 文件已不存在，已跳过")
    except PermissionError:
        yield (-1, "❌ Permission denied")
    except Exception as e:
        yield (-1, f"❌ Error:{str(e)}")


def shred_single_file_system(file_path, passes=2, chunk_size=1024 * 1024):
    if not os.path.isfile(file_path):
        yield (0, "skip:not a file")
        return
    try:
        if os.path.getsize(file_path) == 0:
            os.remove(file_path)
            yield (100, "OK:empty removed")
            return
        proc = subprocess.Popen(
            ["shred", f"-n{passes}", "-u", "-z", "-v", file_path],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, bufsize=0, text=True)
        yield (0, f"Start shred pass={passes} (+zero pass)")
        while proc.poll() is None:
            line = proc.stderr.readline()
            if not line:
                continue
            m = PAT_PASS.search(line)
            if m:
                p_no, p_total = int(m.group(1)), int(m.group(2))
                yield (int(p_no / p_total * 100), f"Pass {p_no}/{p_total} writing")
        ret = proc.wait()
        proc.stderr.read()
        proc.stdout.read()
        if ret == 0:
            yield (100, "✅ File shredded & deleted")
        else:
            yield (-1, f"❌ shred exited code {ret}")
    except FileNotFoundError:
        yield (-1, "❌ shred 命令未找到，请 pkg install coreutils")
    except PermissionError:
        yield (-1, "❌ Permission denied")
    except Exception as e:
        yield (-1, f"❌ Error:{str(e)}")


def shred_single_file(file_path, passes=2, chunk_size=1024 * 1024):
    if USE_SYSTEM_SHRED:
        yield from shred_single_file_system(file_path, passes, chunk_size)
    else:
        yield from shred_single_file_python(file_path, passes, chunk_size)


def collect_all_files(target_path):
    """收集目标下全部文件；路径镂空（已不存在）时返回空列表而不是崩溃"""
    out = []
    if not target_path:
        return out
    try:
        p = Path(target_path)
        if not os.path.exists(target_path):
            return out
        if p.is_file():
            return [str(p)]
        if p.is_dir():
            for root, _, files in os.walk(p, onerror=lambda e: None):
                for fn in files:
                    fp = os.path.join(root, fn)
                    try:
                        if os.path.isfile(fp):
                            out.append(fp)
                    except OSError:
                        continue
    except OSError:
        pass
    return out


_unit_map = {"K": 1024, "M": 1024 * 1024, "G": 1024 ** 3}


def _parse_size_token(s):
    s = s.strip()
    if not s:
        return None
    m = PAT_SIZE_OLD.match(s)
    if not m:
        return None
    num, unit = m.groups()
    return abs(int(num)) * _unit_map[unit]


def parse_size_interval_spec(spec):
    m = PAT_SIZE_INTERVAL.match(spec.strip())
    if not m:
        return None
    a, b = m.groups()
    return (_parse_size_token(a) if a.strip() else None,
            _parse_size_token(b) if b.strip() else None)


def parse_mdate_spec(spec):
    m = PAT_MDATE.match(spec.strip())
    if not m:
        return None
    op, datestr = m.groups()
    op = op or "="
    try:
        return (op, datetime.strptime(datestr, "%Y-%m-%d").timestamp())
    except ValueError:
        return None


def parse_mtime_spec(spec):
    m = PAT_MTIME_OLD.match(spec.strip())
    if not m:
        return None
    raw = spec.strip()
    num = int(m.group(1))
    op = ">" if raw.startswith("+") else ("<" if raw.startswith("-") else "=")
    return (op, num)


def clip(text, maxcols):
    """按显示宽度裁剪，中文占 2 列，避免 addstr 越界报 ERR"""
    if maxcols <= 0:
        return ""
    out, cols = [], 0
    for ch in str(text):
        wch = 2 if unicodedata.east_asian_width(ch) in ("W", "F") else 1
        if cols + wch > maxcols:
            break
        out.append(ch)
        cols += wch
    return "".join(out)


# ============ Shredder shell history（家目录持久化 + 内存）============
HISTORY_FILE = os.path.join(os.path.expanduser("~"), ".fileshredder_history")
HISTORY_MAX = 200


def load_history():
    """读取家目录历史文件；不存在/无权限/是目录时返回空列表，绝不抛异常"""
    try:
        with open(HISTORY_FILE, "r", encoding="utf-8", errors="ignore") as f:
            lines = f.read().splitlines()
    except (FileNotFoundError, IsADirectoryError):
        return []
    except OSError:
        return []
    out = []
    for raw in lines:
        cmd = raw.strip()
        if cmd and (not out or out[-1] != cmd):
            out.append(cmd)
    return out[-HISTORY_MAX:]


def save_history(entries):
    """原子写入家目录历史文件（先写 .tmp 再 replace），失败只返回 False"""
    try:
        tmp = HISTORY_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            for e in entries[-HISTORY_MAX:]:
                f.write(e.replace("\r", " ").replace("\n", " ") + "\n")
        os.replace(tmp, HISTORY_FILE)
        try:
            os.chmod(HISTORY_FILE, 0o600)
        except OSError:
            pass
        return True
    except OSError:
        return False


def append_history(entries, cmd):
    """追加一条命令：空命令跳过、连续重复跳过、超上限裁剪，并立即落盘"""
    cmd = (cmd or "").strip()
    if not cmd:
        return entries
    if entries and entries[-1] == cmd:
        return entries
    entries.append(cmd)
    if len(entries) > HISTORY_MAX:
        del entries[:-HISTORY_MAX]
    save_history(entries)
    return entries


# ============ RAW stdin reader: UTF-8 chars + ANSI keys + mouse reports ============
class RawKeyReader:
    def __init__(self):
        self.buf = b""
        self.fd = sys.stdin.fileno()

    def available(self):
        return bool(select.select([self.fd], [], [], 0.01)[0])

    def read_one(self):
        while self.available():
            c = os.read(self.fd, 1)
            if not c:
                return None
            self.buf += c

        if not self.buf:
            return None

        b0 = self.buf[0]

        # --- Mouse report: ESC [ < button ; x ; y M/m  (1006 mode) ---
        if self.buf.startswith(b"\x1b[<"):
            endM = self.buf.find(b"M")
            endm = self.buf.find(b"m")
            cands = [x for x in (endM, endm) if x != -1]
            if not cands:
                return None
            end = min(cands)
            body = self.buf[3:end]
            pressed = (self.buf[end:end + 1] == b"M")
            self.buf = self.buf[end + 1:]
            try:
                parts = body.split(b";")
                btn, x, y = int(parts[0]), int(parts[1]), int(parts[2])
                return ("MOUSE", btn, x, y, pressed)
            except Exception:
                return None

        # --- Arrow / other CSI ---
        if self.buf.startswith(b"\x1b["):
            if len(self.buf) < 3:
                return None
            seq = self.buf[:3]
            self.buf = self.buf[3:]
            return {b"\x1b[A": "UP", b"\x1b[B": "DOWN",
                    b"\x1b[C": "RIGHT", b"\x1b[D": "LEFT"}.get(seq, "ESC")

        if b0 == 27:
            self.buf = self.buf[1:]
            return "ESC"
        if b0 in (13, 10):
            self.buf = self.buf[1:]
            return "ENTER"
        if b0 in (8, 127):
            self.buf = self.buf[1:]
            return "BACKSPACE"

        if (b0 & 0x80) == 0:
            ch = self.buf[:1].decode("ascii")
            self.buf = self.buf[1:]
            return ch

        try:
            s = self.buf.decode("utf-8")
            ch = s[0]
            self.buf = self.buf[len(ch.encode("utf-8")):]
            return ch
        except UnicodeDecodeError:
            return None


