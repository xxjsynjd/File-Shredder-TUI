        return [(n, f) for (n, f) in allp if flt in n.lower()]

    def tp_dirs():
        try:
            names = sorted(os.listdir(TP["path"]))
        except OSError:
            return []
        out = []
        for n in names:
            fp = os.path.join(TP["path"], n)
            if os.path.isdir(fp) and os.access(fp, os.R_OK | os.X_OK):
                out.append((n, fp))
        return out

