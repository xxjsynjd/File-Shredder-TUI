    def do_permanent_delete():
        """踩着两级确认后的真删除：目录用 rmtree，文件用 remove，不覆写"""
        nonlocal mode, delete_mode
        ok = 0
        fail = 0
        first_err = ""
        for ent in all_selected_entries:
            if ent.get("is_parent_link"):
                continue
            p = ent["path"]
            if not os.path.exists(p):
                continue
            try:
                if os.path.isdir(p):
                    shutil.rmtree(p)
                else:
                    os.remove(p)
                ok += 1
            except OSError as e:
                fail += 1
                if not first_err:
                    first_err = f"{os.path.basename(p.rstrip('/'))}: " \
                                f"{getattr(e, 'strerror', None) or e}"
        delete_mode = "shred"
        mode = MODE_LIST
        rescan_directory()
        msg = f"✓ 已彻底删除 {ok} 项（未覆写内容）"
        if fail:
            msg += f"，✗ {fail} 项失败（{first_err}）"
        set_status(msg)

