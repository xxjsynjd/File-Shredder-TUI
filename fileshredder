    def apply_prop_edit():
        """把 prop_edit_buf 应用到当前字段 -> (ok, msg)"""
        nonlocal prop_path, prop_title, prop_msg, dirty
        field = PROP_FIELDS[prop_edit_idx][0]
        raw = prop_edit_buf.strip()
        if not raw:
            return True, "未改动"
        parent = os.path.dirname(prop_path.rstrip("/")) or "/"
        if field == "name":
            if "/" in raw or raw in (".", ".."):
                return False, "名称不能包含 /，也不能是 . 或 .."
            target = os.path.join(parent, raw)
            if target == prop_path:
                return True, "名称未变"
            if os.path.lexists(target):
                return False, f"同名已存在: {raw}"
            try:
                os.rename(prop_path, target)
            except PermissionError:
                return False, "无权限重命名（Android 存储目录常见，检查 MANAGE_EXTERNAL_STORAGE）"
            except OSError as e:
                return False, f"重命名失败: {getattr(e, 'strerror', None) or e}"
            prop_path = target
            prop_title = raw
            rescan_directory()
            return True, f"已重命名为 {raw}"
        st = None
        try:
            st = os.lstat(prop_path)
        except OSError as e:
            return False, f"无法读取属性: {getattr(e, 'strerror', None) or e}"
        if field == "perm":
            low = raw.lower()
            if low.startswith("0o"):
                digits = low[2:]
            elif low.startswith("0x"):
                digits = low[2:]
            else:
                digits = low
            try:
                val = int(digits, 8)
            except ValueError:
                return False, "权限要写成八进制，例如 644 / 755 / 600"
            if val < 0 or val > 0o7777:
                return False, "权限范围 0000-7777"
            try:
                os.chmod(prop_path, val)
            except (PermissionError, OSError) as e:
                # Android /sdcard 是 FUSE 假文件系统，权限位是虚拟的（chmod 一律 EPERM）。
                # 退一步试 shell chmod（Termux 里有时能绕过一层），仍失败就给明确说明。
                sh = shutil.which("chmod")
                ok = False
                if sh:
                    try:
                        ok = subprocess.call([sh, oct(val)[2:], prop_path],
                                             stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL) == 0
                    except (OSError, ValueError):
                        ok = False
                if ok:
                    return True, f"权限已改为 {oct(val)[2:]}（经 chmod 命令）"
                err = getattr(e, "strerror", None) or e
                if str(prop_path).startswith(("/sdcard", "/storage/emulated")):
                    return False, (f"{err}：/sdcard 是 FUSE 假文件系统，权限位固定为 644/755，"
                                   "系统层面不允许改（改到 /data/data 或 $HOME 下才有效）")
                return False, f"chmod 失败：{err}"
            return True, f"权限已改为 {oct(val)[2:]}"
        if field == "mtime":
            ts = parse_time_input(raw, st.st_mtime)
            if ts is None:
                return False, "时间格式：2026-11-27 / 2026-11-27 15:30:00 / +3（天后） / now"
            try:
                os.utime(prop_path, (st.st_atime, ts))
            except (PermissionError, OSError) as e:
                # 同样退一步用 touch -m（部分 ROM 的 FUSE 只放行 toybox 的 touch）
                touch = shutil.which("touch")
                stamp = time.strftime("%Y%m%d%H%M.%S", time.localtime(ts))
                ok = False
                if touch:
                    try:
                        ok = subprocess.call([touch, "-m", "-t", stamp, prop_path],
                                             stdout=subprocess.DEVNULL,
                                             stderr=subprocess.DEVNULL) == 0
                    except (OSError, ValueError):
                        ok = False
                if ok:
                    return True, f"修改时间已改为 {fmt_time(ts)}（经 touch -m）"
                err = getattr(e, "strerror", None) or e
                return False, f"utime 失败：{err}"
            return True, f"修改时间已改为 {fmt_time(ts)}"
        return False, "该字段不可编辑"

